import { Button, Switch, SpinBox, ScrollView } from "std-widgets.slint";
import { SettingsColors, SettingsCard } from "settings-common.slint";

component SettingToggle inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in property <bool> checked;
    in property <bool> available: true;
    callback toggle(bool);
    min-height: 48px;
    changed checked => { control.checked = root.checked; }
    HorizontalLayout {
        spacing: 24px;
        VerticalLayout {
            alignment: center;
            spacing: 5px;
            Text { text: root.label; color: SettingsColors.text; font-size: 12px; font-weight: 600; }
            if root.detail != "": Text { text: root.detail; color: SettingsColors.secondary; font-size: 11px; wrap: word-wrap; }
        }
        control := Switch {
            checked: root.checked;
            enabled: root.available;
            accessible-label: root.label;
            toggled => {
                root.toggle(self.checked);
                control.checked = root.checked;
            }
        }
    }
}

export component AppSettings inherits Rectangle {
    in property <bool> integrations;
    in property <bool> dirty;
    callback review();
    in property <bool> claude-installed;
    // Human-readable state of the hook wiring, e.g. "8 of 8 hooks installed".
    in property <string> claude-status: "checking…";
    // Whether Claude Code's own directory exists on this machine at all. A
    // machine without it is a normal machine; the row says what it found.
    in property <bool> claude-present: true;
    in property <bool> codex-installed;
    in property <bool> codex-present: true;
    in property <string> codex-status: "checking…";
    callback install-codex();
    callback uninstall-codex();

    in property <bool> completion-notifications: true;
    callback set-completion-notifications(bool);

    // The outcome of the last button press, shown along the bottom.
    in property <string> app-message;

    callback install();
    callback uninstall();

    in property <bool> taskbar-enabled: true;
    // What the readout actually managed to do — embedded in the taskbar, or
    // floating against it because the shell would not take a child.
    in property <string> taskbar-status;
    callback set-taskbar-enabled(bool);

    // Read from the registry, which is the mechanism itself, so this can never
    // drift from what Windows will actually do.
    in property <bool> run-at-login;
    callback set-run-at-login(bool);

    in property <bool> show-claude: true;
    in property <bool> show-codex: true;
    // "claude" | "codex", and whether it gets its block in the readout.
    callback set-agent-shown(string, bool);

    // Where the percentage-left colour turns; see `usage_cache::left_tier`.
    in property <int> good-at: 50;
    in property <int> warn-at: 20;
    callback set-thresholds(int, int);


    VerticalLayout {
        spacing: 14px;
        Text { text: root.integrations ? "Integrations" : "Taskbar & app"; font-size: 16px; font-weight: 600; color: SettingsColors.text; }
        Text {
            text: root.integrations ? "Connect approvals and questions to your companion." : "Choose how your companion works. Changes save automatically.";
            color: SettingsColors.secondary;
            font-size: 11px;
            wrap: word-wrap;
        }
        ScrollView {
            viewport-width: self.visible-width;
            horizontal-scrollbar-policy: always-off;
            VerticalLayout {
                alignment: start;
                spacing: 14px;
                if !root.integrations: SettingsCard {
                    VerticalLayout {
                        padding: 18px;
                        spacing: 10px;
                        SettingToggle {
                            label: "Start at login";
                            detail: "Keep Agent Companion ready when you sign in to Windows.";
                            checked: root.run-at-login;
                            toggle(enabled) => { root.set-run-at-login(enabled); }
                        }
                        Rectangle { height: 1px; background: SettingsColors.border; }
                        SettingToggle {
                            label: "Completion notifications";
                            detail: "Notify when a background task finishes.";
                            checked: root.completion-notifications;
                            toggle(enabled) => { root.set-completion-notifications(enabled); }
                        }
                    }
                }
                if !root.integrations: SettingsCard {
                    VerticalLayout {
                        padding: 18px;
                        spacing: 10px;
                        SettingToggle {
                            label: "Show in taskbar";
                            detail: root.taskbar-status;
                            checked: root.taskbar-enabled;
                            toggle(enabled) => { root.set-taskbar-enabled(enabled); }
                        }
                        Rectangle { height: 1px; background: SettingsColors.border; }
                        SettingToggle {
                            label: "Codex";
                            checked: root.show-codex;
                            available: root.taskbar-enabled;
                            toggle(enabled) => { root.set-agent-shown("codex", enabled); }
                        }
                        SettingToggle {
                            label: "Claude Code";
                            detail: "Experimental";
                            checked: root.show-claude;
                            available: root.taskbar-enabled;
                            toggle(enabled) => { root.set-agent-shown("claude", enabled); }
                        }
                    }
                }
                if !root.integrations: SettingsCard {
                    VerticalLayout {
                        padding: 18px;
                        spacing: 12px;
                        Text { text: "Remaining allowance colors"; font-size: 12px; font-weight: 600; color: SettingsColors.text; }
                        HorizontalLayout {
                            spacing: 10px;
                            Text { text: "Green ≥"; font-size: 11px; color: SettingsColors.secondary; vertical-alignment: center; }
                            good := SpinBox {
                                minimum: 1; maximum: 100; value: root.good-at;
                                edited(value) => { root.set-thresholds(value, warn.value); }
                            }
                            Text { text: "%     Amber ≥"; font-size: 11px; color: SettingsColors.secondary; vertical-alignment: center; }
                            warn := SpinBox {
                                minimum: 0; maximum: 99; value: root.warn-at;
                                edited(value) => { root.set-thresholds(good.value, value); }
                            }
                            Text { text: "%"; font-size: 11px; color: SettingsColors.secondary; vertical-alignment: center; }
                            Rectangle { horizontal-stretch: 1; }
                        }
                    }
                }
                if root.integrations: SettingsCard {
                    VerticalLayout {
                        padding: 18px;
                        spacing: 12px;
                        HorizontalLayout {
                            spacing: 24px;
                            VerticalLayout {
                                spacing: 6px;
                                Text { text: "Codex"; font-size: 13px; font-weight: 600; color: SettingsColors.text; }
                                Text { text: root.codex-status; font-size: 11px; color: SettingsColors.secondary; wrap: word-wrap; }
                            }
                            Button {
                                horizontal-stretch: 0;
                                min-width: 132px;
                                text: root.codex-installed ? "Uninstall hooks" : "Install hooks";
                                enabled: root.codex-present;
                                clicked => { if root.codex-installed { root.uninstall-codex(); } else { root.install-codex(); } }
                            }
                        }
                        Text { text: "Tasks and Usage work without hooks. Install hooks for approvals and terminal details; review them with /hooks in Codex."; font-size: 11px; color: SettingsColors.secondary; wrap: word-wrap; }
                    }
                }
                if root.integrations: SettingsCard {
                    VerticalLayout {
                        padding: 18px;
                        spacing: 12px;
                        HorizontalLayout {
                            spacing: 24px;
                            VerticalLayout {
                                spacing: 6px;
                                Text { text: "Claude Code · experimental"; font-size: 13px; font-weight: 600; color: SettingsColors.text; }
                                Text { text: root.claude-status; font-size: 11px; color: SettingsColors.secondary; wrap: word-wrap; }
                            }
                            Button {
                                horizontal-stretch: 0;
                                min-width: 132px;
                                text: root.claude-installed ? "Uninstall hooks" : "Install hooks";
                                enabled: root.claude-present;
                                clicked => { if root.claude-installed { root.uninstall(); } else { root.install(); } }
                            }
                        }
                        Text { text: "Hooks are added alongside your existing configuration. Uninstall removes only Agent Companion hooks."; font-size: 11px; color: SettingsColors.secondary; wrap: word-wrap; }
                    }
                }
                if root.app-message != "": Text { text: root.app-message; color: SettingsColors.secondary; font-size: 11px; wrap: word-wrap; }
            }
        }
        if root.dirty: SettingsCard {
            background: SettingsColors.selected;
            HorizontalLayout {
                padding: 12px;
                spacing: 12px;
                Text { text: "You have unapplied Codex CLI changes."; font-size: 11px; color: SettingsColors.accent; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                Button { text: "Review changes"; clicked => { root.review(); } }
            }
        }
    }
}
