import { Button, CheckBox, ScrollView, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { MacSettings } from "macos-settings.slint";
import { StatusComponent } from "status-component.slint";
export { StatusComponent }
export { Palette } from "std-widgets.slint";

component ComponentOption inherits Rectangle {
    in property <StatusComponent> item;
    in property <bool> available;
    callback toggle(string, bool);
    min-height: 52px;
    HorizontalLayout {
        padding-left: 2px;
        padding-right: 12px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            CheckBox {
                text: root.item.label;
                checked: root.item.selected;
                enabled: root.available;
                toggled => { root.toggle(root.item.id, self.checked); }
            }
            Text {
                text: root.item.description;
                font-size: 11px;
                wrap: word-wrap;
                color: #808080;
            }
        }
    }
}

export component CodexTuiWindow inherits Window {
    in property <string> window-title: "Agent Companion · Codex TUI";
    title: root.window-title;
    preferred-width: root.macos-preferences ? 920px : 740px;
    preferred-height: root.macos-preferences ? 760px : 720px;
    min-width: root.macos-preferences ? 820px : 620px;
    min-height: root.macos-preferences ? 660px : 620px;
    in property <[StatusComponent]> left-components;
    in property <[StatusComponent]> right-components;
    in property <string> preview;
    in property <string> mono-font: "Consolas";
    in property <int> selected-count;
    in property <bool> ready;
    in property <bool> dirty;
    in property <bool> custom;
    in property <string> message;
    in property <bool> error;
    in property <string> config-path;
    in property <string> catalog-version;
    in property <bool> macos-preferences;
    in property <bool> show-dock-icon;
    in property <bool> dock-error;
    callback toggle-dock-icon(bool);
    callback toggle(string, bool);
    callback apply();
    callback restore-defaults();

    if root.macos-preferences: MacSettings {
        left-components: root.left-components;
        right-components: root.right-components;
        preview: root.preview;
        mono-font: root.mono-font;
        selected-count: root.selected-count;
        ready: root.ready;
        dirty: root.dirty;
        custom: root.custom;
        message: root.message;
        error: root.error;
        config-path: root.config-path;
        catalog-version: root.catalog-version;
        show-dock-icon: root.show-dock-icon;
        dock-error: root.dock-error;
        toggle-dock-icon(visible) => { root.toggle-dock-icon(visible); }
        toggle(id, enabled) => { root.toggle(id, enabled); }
        apply => { root.apply(); }
        restore-defaults => { root.restore-defaults(); }
    }

    if !root.macos-preferences: VerticalBox {
        padding: 20px;
        spacing: 12px;
        VerticalLayout {
            spacing: 4px;
            Text { text: "Make the status bar yours"; font-size: 22px; font-weight: 600; }
            Text { text: "Choose what stays at the bottom of Codex CLI."; font-size: 12px; }
        }

        Rectangle {
            height: 174px;
            background: #14171b;
            border-radius: 6px;
            VerticalLayout {
                padding: 16px;
                spacing: 8px;
                HorizontalLayout {
                    Text { text: "›_ Codex CLI"; color: #cdd3db; font-family: root.mono-font; font-size: 12px; }
                    Text { text: "Preview · sample values"; color: #98a3af; font-size: 11px; horizontal-alignment: right; }
                }
                Text { text: "• Ready to work on agent-companion."; color: #98a3af; font-family: root.mono-font; font-size: 12px; }
                Rectangle { height: 1px; background: #3e444d; }
                Text { text: "› Ask Codex to do anything"; color: #ebeff5; font-family: root.mono-font; font-size: 12px; }
                Rectangle {
                    background: #222831;
                    border-radius: 3px;
                    min-height: 40px;
                    ScrollView {
                        viewport-width: self.width;
                        VerticalLayout {
                            padding: 8px;
                            Text {
                                text: !root.ready ? "Preview unavailable" : root.selected-count == 0 ? "Status bar hidden" : root.preview;
                                color: #a8c6e6;
                                font-family: root.mono-font;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            Text { text: "Visible components"; font-weight: 600; }
            Text {
                text: root.ready ? root.selected-count + " selected · check to show" : "";
                font-size: 11px;
                horizontal-alignment: right;
            }
        }
        ScrollView {
            vertical-stretch: 1;
            viewport-width: self.width;
            HorizontalLayout {
                spacing: 14px;
                VerticalLayout {
                    alignment: start;
                    for item in root.left-components: ComponentOption {
                        item: item;
                        available: root.ready;
                        toggle(id, enabled) => { root.toggle(id, enabled); }
                    }
                }
                VerticalLayout {
                    alignment: start;
                    for item in root.right-components: ComponentOption {
                        item: item;
                        available: root.ready;
                        toggle(id, enabled) => { root.toggle(id, enabled); }
                    }
                }
            }
        }
        Text {
            text: "Components appear in Codex when data is available. Preview wraps to show your full selection.";
            font-size: 11px;
            wrap: word-wrap;
        }
        Rectangle { height: 1px; background: #80808040; }
        HorizontalBox {
            padding: 0px;
            Button {
                text: "Restore Codex defaults";
                enabled: root.ready && (root.custom || root.dirty);
                clicked => { root.restore-defaults(); }
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: root.dirty ? "Unapplied changes" : root.ready ? (root.custom ? "Custom status bar" : "Codex defaults") : "";
                vertical-alignment: center;
                font-size: 11px;
            }
            Button {
                text: "Apply";
                primary: true;
                enabled: root.ready && root.dirty;
                clicked => { root.apply(); }
            }
        }
        Text {
            text: root.message;
            color: root.error ? #c42b1c : #808080;
            font-size: 12px;
            wrap: word-wrap;
            min-height: 34px;
        }
        Text {
            text: "User configuration · " + root.config-path + "\nComponent catalog: Codex CLI " + root.catalog-version;
            font-size: 11px;
            wrap: word-wrap;
        }
    }
}
