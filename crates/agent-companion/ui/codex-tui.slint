import { Button } from "std-widgets.slint";
import { MacSettings } from "macos-settings.slint";
import { AppSettings } from "settings.slint";
import { SettingsColors } from "settings-common.slint";
import { StatusBarSettings } from "statusbar-settings.slint";
import { StatusComponent } from "status-component.slint";
export { StatusComponent }
export { Palette } from "std-widgets.slint";

export component CodexTuiWindow inherits Window {
    in property <string> window-title: "Agent Companion · Codex TUI";
    title: root.window-title;
    preferred-width: root.macos-preferences ? 920px : 820px;
    preferred-height: root.macos-preferences ? 760px : 720px;
    min-width: root.macos-preferences ? 820px : 720px;
    min-height: root.macos-preferences ? 660px : 640px;
    in property <[StatusComponent]> left-components;
    in property <[StatusComponent]> right-components;
    in property <string> preview;
    in property <string> mono-font: "Consolas";
    in property <int> selected-count;
    in property <bool> ready;
    in property <bool> dirty;
    in property <bool> custom;
    in property <string> message;
    in property <bool> error;
    in property <string> config-path;
    in property <string> catalog-version;
    in property <bool> claude-installed;
    // Human-readable state of the hook wiring, e.g. "8 of 8 hooks installed".
    in property <string> claude-status: "checking…";
    // Whether Claude Code's own directory exists on this machine at all. A
    // machine without it is a normal machine; the row says what it found.
    in property <bool> claude-present: true;
    in property <bool> codex-installed;
    in property <bool> codex-present: true;
    in property <string> codex-status: "checking…";
    callback install-codex();
    callback uninstall-codex();

    in property <bool> completion-notifications: true;
    callback set-completion-notifications(bool);

    // The outcome of the last button press, shown along the bottom.
    in property <string> app-message;

    callback install();
    callback uninstall();

    in property <bool> taskbar-enabled: true;
    // What the readout actually managed to do — embedded in the taskbar, or
    // floating against it because the shell would not take a child.
    in property <string> taskbar-status;
    callback set-taskbar-enabled(bool);

    // Read from the registry, which is the mechanism itself, so this can never
    // drift from what Windows will actually do.
    in property <bool> run-at-login;
    callback set-run-at-login(bool);

    in property <bool> show-claude: true;
    in property <bool> show-codex: true;
    // "claude" | "codex", and whether it gets its block in the readout.
    callback set-agent-shown(string, bool);

    // Where the percentage-left colour turns; see `usage_cache::left_tier`.
    in property <int> good-at: 50;
    in property <int> warn-at: 20;
    callback set-thresholds(int, int);

    in property <bool> windows-preferences;
    in property <bool> macos-preferences;
    in-out property <int> settings-page: 0;
    in property <bool> show-dock-icon;
    in property <bool> dock-error;
    in property <[string]> display-options;
    in-out property <int> selected-display;
    in property <string> display-status;
    in property <bool> display-error;
    callback select-display(string);
    callback toggle-dock-icon(bool);
    callback toggle(string, bool);
    callback apply();
    callback restore-defaults();

    if root.macos-preferences: MacSettings {
        current-page <=> root.settings-page;
        left-components: root.left-components;
        right-components: root.right-components;
        preview: root.preview;
        mono-font: root.mono-font;
        selected-count: root.selected-count;
        ready: root.ready;
        dirty: root.dirty;
        custom: root.custom;
        message: root.message;
        error: root.error;
        config-path: root.config-path;
        catalog-version: root.catalog-version;
        show-dock-icon: root.show-dock-icon;
        dock-error: root.dock-error;
        display-options: root.display-options;
        selected-display <=> root.selected-display;
        display-status: root.display-status;
        display-error: root.display-error;
        select-display(label) => { root.select-display(label); }
        toggle-dock-icon(visible) => { root.toggle-dock-icon(visible); }
        toggle(id, enabled) => { root.toggle(id, enabled); }
        apply => { root.apply(); }
        restore-defaults => { root.restore-defaults(); }
    }

    if !root.macos-preferences: Rectangle {
        background: SettingsColors.background;
        VerticalLayout {
            padding: 24px;
            spacing: 18px;
            HorizontalLayout {
                Text { text: root.windows-preferences ? "Settings" : "Codex CLI"; font-size: 24px; font-weight: 700; color: SettingsColors.text; }
                Text { text: "Agent Companion"; font-size: 12px; color: SettingsColors.secondary; horizontal-alignment: right; vertical-alignment: center; }
            }
            if root.windows-preferences: HorizontalLayout {
                height: 36px;
                spacing: 8px;
                for label[index] in ["Codex CLI", "Taskbar & app", "Integrations"]: Button {
                    text: label;
                    primary: root.settings-page == index;
                    clicked => { root.settings-page = index; }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            Rectangle {
                vertical-stretch: 1;
                StatusBarSettings {
                    visible: !root.windows-preferences || root.settings-page == 0;
                    left-components: root.left-components;
                    right-components: root.right-components;
                    preview: root.preview;
                    mono-font: root.mono-font;
                    selected-count: root.selected-count;
                    ready: root.ready;
                    dirty: root.dirty;
                    custom: root.custom;
                    message: root.message;
                    error: root.error;
                    config-path: root.config-path;
                    catalog-version: root.catalog-version;
                    toggle(id, enabled) => { root.toggle(id, enabled); }
                    apply => { root.apply(); }
                    restore-defaults => { root.restore-defaults(); }
                }
                AppSettings {
                    visible: root.windows-preferences && root.settings-page != 0;
                    integrations: root.settings-page == 2;
                    dirty: root.dirty;
                    review => { root.settings-page = 0; }
                    claude-installed: root.claude-installed;
                    claude-status: root.claude-status;
                    claude-present: root.claude-present;
                    codex-installed: root.codex-installed;
                    codex-present: root.codex-present;
                    codex-status: root.codex-status;
                    completion-notifications: root.completion-notifications;
                    app-message: root.app-message;
                    taskbar-enabled: root.taskbar-enabled;
                    taskbar-status: root.taskbar-status;
                    run-at-login: root.run-at-login;
                    show-claude: root.show-claude;
                    show-codex: root.show-codex;
                    good-at: root.good-at;
                    warn-at: root.warn-at;
                    install() => { root.install(); }
                    uninstall() => { root.uninstall(); }
                    install-codex() => { root.install-codex(); }
                    uninstall-codex() => { root.uninstall-codex(); }
                    set-completion-notifications(enabled) => { root.set-completion-notifications(enabled); }
                    set-taskbar-enabled(enabled) => { root.set-taskbar-enabled(enabled); }
                    set-run-at-login(enabled) => { root.set-run-at-login(enabled); }
                    set-agent-shown(agent, shown) => { root.set-agent-shown(agent, shown); }
                    set-thresholds(good, warn) => { root.set-thresholds(good, warn); }
                }
            }
        }
    }
}
