import { Button, ComboBox, Switch, TabWidget } from "std-widgets.slint";
import { StatusComponent } from "status-component.slint";

import { SettingsColors, SettingsCard } from "settings-common.slint";
import { StatusBarSettings } from "statusbar-settings.slint";

export component MacSettings inherits Rectangle {
    in-out property <int> current-page: 0;
    in property <[StatusComponent]> left-components;
    in property <[StatusComponent]> right-components;
    in property <string> preview;
    in property <string> mono-font;
    in property <int> selected-count;
    in property <bool> ready;
    in property <bool> dirty;
    in property <bool> custom;
    in property <string> message;
    in property <bool> error;
    in property <string> config-path;
    in property <string> catalog-version;
    in property <bool> show-dock-icon;
    in property <bool> dock-error;
    in property <[string]> display-options;
    in-out property <int> selected-display;
    in property <string> display-status;
    in property <bool> display-error;
    callback select-display(string);
    callback toggle-dock-icon(bool);
    callback toggle(string, bool);
    callback apply();
    callback restore-defaults();

    background: SettingsColors.background;
    VerticalLayout {
        padding: 20px;
        spacing: 16px;
        HorizontalLayout {
            height: 44px;
            spacing: 12px;
            Rectangle {
                width: 40px;
                height: 40px;
                background: #172b22;
                border-radius: 11px;
                Text {
                    text: "›_";
                    font-family: root.mono-font;
                    font-size: 21px;
                    font-weight: 600;
                    color: #8de1b9;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 4px;
                Text { text: "Settings"; font-size: 20px; font-weight: 700; color: SettingsColors.text; }
                Text { text: "Make your workspace feel right."; font-size: 11px; color: SettingsColors.secondary; }
            }
            Text {
                text: "Agent Companion";
                font-size: 11px;
                color: SettingsColors.secondary;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }

        TabWidget {
            current-index <=> root.current-page;
            Tab {
                title: "Codex CLI";
                VerticalLayout {
                    padding-top: 20px;
                    StatusBarSettings {
                        left-components: root.left-components;
                        right-components: root.right-components;
                        preview: root.preview;
                        mono-font: root.mono-font;
                        selected-count: root.selected-count;
                        ready: root.ready;
                        dirty: root.dirty;
                        custom: root.custom;
                        message: root.message;
                        error: root.error;
                        config-path: root.config-path;
                        catalog-version: root.catalog-version;
                        toggle(id, enabled) => { root.toggle(id, enabled); }
                        apply => { root.apply(); }
                        restore-defaults => { root.restore-defaults(); }
                    }
                }
            }
            Tab {
                title: "Notch & app";
                VerticalLayout {
                    padding-top: 20px;
                    spacing: 18px;
                    VerticalLayout {
                        spacing: 5px;
                        Text { text: "Notch & app"; font-size: 16px; font-weight: 600; color: SettingsColors.text; }
                        Text { text: "Choose where your companion lives. Changes save automatically."; font-size: 11px; color: SettingsColors.secondary; }
                    }
                    Text { text: "Display"; font-size: 12px; font-weight: 600; color: SettingsColors.text; }
                    SettingsCard {
                        vertical-stretch: 0;
                        VerticalLayout {
                            padding: 18px;
                            spacing: 14px;
                            HorizontalLayout {
                                spacing: 24px;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 5px;
                                    Text { text: "Notch display"; font-size: 12px; font-weight: 600; color: SettingsColors.text; }
                                    Text { text: "Follow your main screen or choose a display."; font-size: 10.5px; color: SettingsColors.secondary; wrap: word-wrap; }
                                }
                                ComboBox {
                                    width: 340px;
                                    height: 32px;
                                    model: root.display-options;
                                    current-index <=> root.selected-display;
                                    enabled: root.display-options.length > 0;
                                    accessible-label: "Notch display";
                                    selected(label) => { root.select-display(label); }
                                }
                            }
                            Rectangle { height: 1px; background: SettingsColors.border; }
                            Text {
                                text: root.display-error ? "Could not save the display choice. Please try again." : root.display-status;
                                color: root.display-error ? SettingsColors.error : SettingsColors.secondary;
                                font-size: 10.5px;
                                wrap: word-wrap;
                            }
                        }
                    }
                    Text { text: "App appearance"; font-size: 12px; font-weight: 600; color: SettingsColors.text; }
                    SettingsCard {
                        vertical-stretch: 0;
                        HorizontalLayout {
                            padding: 18px;
                            spacing: 24px;
                            VerticalLayout {
                                alignment: center;
                                spacing: 5px;
                                Text { text: "Show in Dock"; font-size: 12px; font-weight: 600; color: SettingsColors.text; }
                                Text {
                                    text: root.dock-error ? "Could not save. Please try again." : "When hidden, open Settings from the notch.";
                                    font-size: 10.5px;
                                    color: root.dock-error ? SettingsColors.error : SettingsColors.secondary;
                                    wrap: word-wrap;
                                }
                            }
                            Switch {
                                checked: root.show-dock-icon;
                                accessible-label: "Show Agent Companion in the Dock";
                                toggled => { root.toggle-dock-icon(self.checked); }
                            }
                        }
                    }
                    if root.dirty: SettingsCard {
                        vertical-stretch: 0;
                        background: SettingsColors.selected;
                        HorizontalLayout {
                            padding: 14px;
                            spacing: 16px;
                            Text {
                                text: "You have unapplied Codex CLI changes.";
                                font-size: 11px;
                                color: SettingsColors.accent;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Button {
                                text: "Review changes";
                                height: 28px;
                                clicked => { root.current-page = 0; }
                            }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                }
            }
        }
    }
}
