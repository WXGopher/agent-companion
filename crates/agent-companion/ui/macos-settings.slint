import { ComboBox, Switch } from "std-widgets.slint";
import { StatusComponent } from "status-component.slint";

import { SettingsColors, SettingsCard, SettingsButton, SettingsTextField } from "settings-common.slint";
import { StatusBarSettings } from "statusbar-settings.slint";
import { ProfileSyncFile } from "profile-sync.slint";
import { SoftwareVersion } from "software-updates.slint";

import { DualSettings } from "dual-settings.slint";
import { UpdateCheck } from "update-check.slint";

export component MacSettings inherits Rectangle {
    in property <bool> update-checking;
    in property <bool> update-failed;
    in property <bool> update-available;
    in property <string> update-message;
    callback check-updates();
    callback view-release();
    in property <[SoftwareVersion]> software-versions;
    in property <bool> software-busy;
    in property <bool> software-error;
    in property <string> software-message;
    in property <string> software-notice;
    callback maintain-software(string);
    in property <int> usage-refresh-minutes: 5;
    in property <string> usage-settings-message;
    callback set-usage-refresh-minutes(string);
    in-out property <bool> run-at-login;
    in property <bool> login-item-available;
    in property <bool> login-item-requires-approval;
    in property <bool> login-item-error;
    in property <string> login-item-message;
    callback set-run-at-login(bool);
    callback open-login-item-settings();
    in-out property <int> current-page: 0;
    in property <[StatusComponent]> left-components;
    in property <[StatusComponent]> right-components;
    in property <string> preview;
    in property <string> mono-font;
    in property <int> selected-count;
    in property <bool> ready;
    in property <bool> dirty;
    in property <bool> custom;
    in property <string> message;
    in property <bool> error;
    in property <string> config-path;
    in property <string> catalog-version;
    in property <bool> dual-enabled;
    in property <bool> dual-deployed;
    in property <bool> dual-tui-installed;
    in property <string> dual-command-path;
    in property <string> dual-package-path;
    in property <string> dual-profile-home;
    in property <string> dual-database-dir;
    in property <string> dual-log-dir;
    in property <bool> dual-tui-available;
    in property <bool> dual-tui-configured;
    in property <bool> dual-busy;
    in property <bool> dual-error;
    in property <string> dual-phase;
    in property <string> dual-message;
    in property <[ProfileSyncFile]> sync-files;
    in property <bool> sync-busy;
    in property <string> sync-status;
    in property <bool> sync-error;
    in-out property <length> dual-scroll-y;
    in-out property <bool> dual-advanced-open;
    in property <[string]> instance-options;
    in-out property <int> selected-instance;
    callback deploy-dual();
    callback open-dual();
    callback toggle-dual(bool);
    callback select-instance(string);
    callback sync-profile(string, bool);
    callback open-sync-file(string, bool, bool);
    callback refresh-sync();
    callback toggle(string, bool);
    callback apply();
    callback restore-defaults();

    background: SettingsColors.background;
    VerticalLayout {
        padding: 24px;
        spacing: 16px;
        HorizontalLayout {
            height: 44px;
            spacing: 12px;
            Rectangle {
                width: 40px;
                height: 40px;
                background: #172b22;
                border-radius: 11px;
                Text {
                    text: "›_";
                    font-family: root.mono-font;
                    font-size: 21px;
                    font-weight: 600;
                    color: #8de1b9;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 4px;
                Text { text: "设置"; font-size: 24px; font-weight: 600; color: SettingsColors.text; }
                Text { text: "管理实例与工作偏好"; font-size: 12px; color: SettingsColors.secondary; }
            }
            Text {
                text: "Agent Companion";
                font-size: 12px;
                color: SettingsColors.secondary;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }

        UpdateCheck {
            checking: root.update-checking;
            failed: root.update-failed;
            available: root.update-available;
            message: root.update-message;
            check => { root.check-updates(); }
            view-release => { root.view-release(); }
        }
        HorizontalLayout {
            height: 32px;
            spacing: 8px;
            SettingsButton { text: "通用"; width: 100px; primary: root.current-page == 2; clicked => { root.current-page = 2; } }
            SettingsButton { text: "Codex CLI"; width: 132px; primary: root.current-page == 0; clicked => { root.current-page = 0; } }
            SettingsButton { text: "TUI 双开"; width: 132px; primary: root.current-page == 1; clicked => { root.current-page = 1; } }
            Rectangle { horizontal-stretch: 1; }
        }
        Rectangle {
            vertical-stretch: 1;
            if root.current-page == 2: VerticalLayout {
                padding-top: 4px;
                spacing: 16px;
                alignment: start;
                SettingsCard {
                    vertical-stretch: 0;
                    VerticalLayout {
                        padding: 18px;
                        spacing: 10px;
                        HorizontalLayout {
                            Text { text: "开机自动启动"; font-size: 13px; font-weight: 600; color: SettingsColors.text; vertical-alignment: center; }
                            login-switch := Switch {
                                text: "登录时自动启动";
                                checked <=> root.run-at-login;
                                enabled: root.login-item-available;
                                toggled => { root.set-run-at-login(self.checked); }
                            }
                        }
                        Text {
                            text: root.login-item-message;
                            font-size: 12px;
                            color: root.login-item-error ? SettingsColors.error : SettingsColors.secondary;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            SettingsButton {
                                text: "系统登录项设置";
                                width: 156px;
                                clicked => { root.open-login-item-settings(); }
                            }
                            if root.login-item-requires-approval: SettingsButton {
                                text: "取消自动启动";
                                width: 132px;
                                clicked => { root.set-run-at-login(false); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                    }
                }
                SettingsCard {
                    vertical-stretch: 0;
                    HorizontalLayout {
                        padding: 18px;
                        spacing: 16px;
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "额度自动刷新间隔（分钟）"; font-size: 12px; color: SettingsColors.text; }
                            Text {
                                text: root.usage-settings-message == "" ? "所有实例共用，1–60 分钟；保存后重新计时。" : root.usage-settings-message;
                                wrap: word-wrap;
                                font-size: 12px;
                                color: SettingsColors.secondary;
                            }
                        }
                        usage-interval := SettingsTextField {
                            width: 72px;
                            height: 32px;
                            text: root.usage-refresh-minutes;
                            accessible-label: "额度自动刷新间隔（分钟）";
                            accepted => { root.set-usage-refresh-minutes(self.text); }
                        }
                        SettingsButton {
                            width: 80px;
                            text: "保存";
                            clicked => { root.set-usage-refresh-minutes(usage-interval.text); }
                        }
                    }
                }
            }
            if root.current-page == 0: VerticalLayout {
                    padding-top: 4px;
                    spacing: 10px;
                    if root.dual-enabled: HorizontalLayout {
                        height: 30px;
                        spacing: 12px;
                        Text { text: "Instance"; font-size: 12px; color: SettingsColors.secondary; vertical-alignment: center; }
                        ComboBox {
                            width: 180px;
                            model: root.instance-options;
                            current-index <=> root.selected-instance;
                            accessible-label: "Status bar configuration instance";
                            selected(label) => { root.select-instance(label); }
                        }
                        Text { text: "Each instance keeps its own draft and saved settings."; font-size: 12px; color: SettingsColors.secondary; vertical-alignment: center; }
                    }
                    StatusBarSettings {
                        left-components: root.left-components;
                        right-components: root.right-components;
                        preview: root.preview;
                        mono-font: root.mono-font;
                        selected-count: root.selected-count;
                        ready: root.ready && !root.sync-busy;
                        dirty: root.dirty;
                        custom: root.custom;
                        message: root.message;
                        error: root.error;
                        config-path: root.config-path;
                        catalog-version: root.catalog-version;
                        toggle(id, enabled) => { root.toggle(id, enabled); }
                        apply => { root.apply(); }
                        restore-defaults => { root.restore-defaults(); }
                    }
            }
            if root.current-page == 1: DualSettings {
                tui-installed: root.dual-tui-installed;
                command-path: root.dual-command-path;
                package-path: root.dual-package-path;
                profile-home: root.dual-profile-home;
                database-dir: root.dual-database-dir;
                log-dir: root.dual-log-dir;
                tui-available: root.dual-tui-available;
                tui-configured: root.dual-tui-configured;
                monitored: root.dual-enabled;
                busy: root.dual-busy;
                error: root.dual-error;
                phase: root.dual-phase;
                message: root.dual-message;
                versions: root.software-versions;
                software-busy: root.software-busy;
                software-error: root.software-error;
                software-message: root.software-message;
                software-notice: root.software-notice;
                sync-files: root.sync-files;
                sync-busy: root.sync-busy;
                sync-status: root.sync-status;
                sync-error: root.sync-error;
                scroll-y <=> root.dual-scroll-y;
                advanced-open <=> root.dual-advanced-open;
                setup => { root.deploy-dual(); }
                open => { root.open-dual(); }
                monitor(enabled) => { root.toggle-dual(enabled); }
                maintain(action) => { root.maintain-software(action); }
                sync-profile(file, to-secondary) => { root.sync-profile(file, to-secondary); }
                open-sync-file(file, secondary, edit) => { root.open-sync-file(file, secondary, edit); }
                refresh-sync => { root.refresh-sync(); }
            }
        }
    }
}
