import { Button, ComboBox, Switch, TabWidget } from "std-widgets.slint";
import { StatusComponent } from "status-component.slint";

import { SettingsColors, SettingsCard } from "settings-common.slint";
import { StatusBarSettings } from "statusbar-settings.slint";

export component MacSettings inherits Rectangle {
    in-out property <int> current-page: 0;
    in property <[StatusComponent]> left-components;
    in property <[StatusComponent]> right-components;
    in property <string> preview;
    in property <string> mono-font;
    in property <int> selected-count;
    in property <bool> ready;
    in property <bool> dirty;
    in property <bool> custom;
    in property <string> message;
    in property <bool> error;
    in property <string> config-path;
    in property <string> catalog-version;
    in property <bool> show-dock-icon;
    in property <bool> dock-error;
    in property <bool> show-menu-bar: true;
    in property <bool> menu-bar-error;
    in property <bool> show-notch;
    in property <bool> notch-error;
    in property <bool> dual-enabled;
    in property <bool> dual-deployed;
    in property <bool> dual-busy;
    in property <bool> dual-error;
    in property <string> dual-phase;
    in property <string> dual-message;
    in property <[string]> instance-options;
    in-out property <int> selected-instance;
    in property <[string]> display-options;
    in-out property <int> selected-display;
    in property <string> display-status;
    in property <bool> display-error;
    callback select-display(string);
    callback toggle-dock-icon(bool);
    callback toggle-menu-bar(bool);
    callback toggle-notch(bool);
    callback deploy-dual();
    callback toggle-dual(bool);
    callback select-instance(string);
    callback toggle(string, bool);
    callback apply();
    callback restore-defaults();

    background: SettingsColors.background;
    VerticalLayout {
        padding: 20px;
        spacing: 16px;
        HorizontalLayout {
            height: 44px;
            spacing: 12px;
            Rectangle {
                width: 40px;
                height: 40px;
                background: #172b22;
                border-radius: 11px;
                Text {
                    text: "›_";
                    font-family: root.mono-font;
                    font-size: 21px;
                    font-weight: 600;
                    color: #8de1b9;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 4px;
                Text { text: "Settings"; font-size: 20px; font-weight: 700; color: SettingsColors.text; }
                Text { text: "Make your workspace feel right."; font-size: 11px; color: SettingsColors.secondary; }
            }
            Text {
                text: "Agent Companion";
                font-size: 11px;
                color: SettingsColors.secondary;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }

        TabWidget {
            current-index <=> root.current-page;
            Tab {
                title: "Codex CLI";
                VerticalLayout {
                    padding-top: 20px;
                    spacing: 10px;
                    if root.dual-enabled: HorizontalLayout {
                        height: 30px;
                        spacing: 12px;
                        Text { text: "Instance"; font-size: 11px; color: SettingsColors.secondary; vertical-alignment: center; }
                        ComboBox {
                            width: 180px;
                            model: root.instance-options;
                            current-index <=> root.selected-instance;
                            accessible-label: "Status bar configuration instance";
                            selected(label) => { root.select-instance(label); }
                        }
                        Text { text: "Each instance keeps its own draft and saved settings."; font-size: 10px; color: SettingsColors.secondary; vertical-alignment: center; }
                    }
                    StatusBarSettings {
                        left-components: root.left-components;
                        right-components: root.right-components;
                        preview: root.preview;
                        mono-font: root.mono-font;
                        selected-count: root.selected-count;
                        ready: root.ready;
                        dirty: root.dirty;
                        custom: root.custom;
                        message: root.message;
                        error: root.error;
                        config-path: root.config-path;
                        catalog-version: root.catalog-version;
                        toggle(id, enabled) => { root.toggle(id, enabled); }
                        apply => { root.apply(); }
                        restore-defaults => { root.restore-defaults(); }
                    }
                }
            }
            Tab {
                title: "Notch & app";
                VerticalLayout {
                    padding-top: 20px;
                    spacing: 12px;
                    VerticalLayout {
                        spacing: 5px;
                        Text { text: "Notch & app"; font-size: 16px; font-weight: 600; color: SettingsColors.text; }
                        Text { text: "Choose where your companion lives. Changes save automatically."; font-size: 11px; color: SettingsColors.secondary; }
                    }
                    Text { text: "Display"; font-size: 12px; font-weight: 600; color: SettingsColors.text; }
                    SettingsCard {
                        vertical-stretch: 0;
                        VerticalLayout {
                            padding: 14px;
                            spacing: 10px;
                            HorizontalLayout {
                                spacing: 24px;
                                VerticalLayout {
                                    spacing: 5px;
                                    Text { text: "Show notch"; font-size: 12px; font-weight: 600; color: SettingsColors.text; }
                                    Text {
                                        text: root.notch-error ? "Could not save. Please try again." : "Show tasks and usage at the top of your screen.";
                                        font-size: 10.5px;
                                        color: root.notch-error ? SettingsColors.error : SettingsColors.secondary;
                                    }
                                }
                                Switch {
                                    checked: root.show-notch;
                                    accessible-label: "Show Agent Companion notch";
                                    toggled => { root.toggle-notch(self.checked); }
                                }
                            }
                            Rectangle { height: 1px; background: SettingsColors.border; }
                            HorizontalLayout {
                                spacing: 24px;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 5px;
                                    Text { text: "Notch display"; font-size: 12px; font-weight: 600; color: SettingsColors.text; }
                                    Text { text: "Follow your main screen or choose a display."; font-size: 10.5px; color: SettingsColors.secondary; wrap: word-wrap; }
                                }
                                ComboBox {
                                    width: 340px;
                                    height: 32px;
                                    model: root.display-options;
                                    current-index <=> root.selected-display;
                                    enabled: root.show-notch && root.display-options.length > 0;
                                    accessible-label: "Notch display";
                                    selected(label) => { root.select-display(label); }
                                }
                            }
                            Rectangle { height: 1px; background: SettingsColors.border; }
                            Text {
                                text: root.display-error ? "Could not save the display choice. Please try again." : root.display-status;
                                color: root.display-error ? SettingsColors.error : SettingsColors.secondary;
                                font-size: 10.5px;
                                wrap: word-wrap;
                            }
                        }
                    }
                    Text { text: "App appearance"; font-size: 12px; font-weight: 600; color: SettingsColors.text; }
                    SettingsCard {
                        vertical-stretch: 0;
                        HorizontalLayout {
                            padding: 14px;
                            spacing: 24px;
                            VerticalLayout {
                                alignment: center;
                                spacing: 5px;
                                Text { text: "Show in menu bar"; font-size: 12px; font-weight: 600; color: SettingsColors.text; }
                                Text {
                                    text: root.menu-bar-error ? "Could not save. Please try again." : "Shows valid weekly quotas, Codex above Dodex; an icon when none are available. Click for tasks and usage.";
                                    font-size: 10.5px;
                                    color: root.menu-bar-error ? SettingsColors.error : SettingsColors.secondary;
                                    wrap: word-wrap;
                                }
                            }
                            Switch {
                                checked: root.show-menu-bar;
                                accessible-label: "Show Agent Companion in the menu bar";
                                toggled => { root.toggle-menu-bar(self.checked); }
                            }
                        }
                    }
                    SettingsCard {
                        vertical-stretch: 0;
                        HorizontalLayout {
                            padding: 14px;
                            spacing: 24px;
                            VerticalLayout {
                                alignment: center;
                                spacing: 5px;
                                Text { text: "Show in Dock"; font-size: 12px; font-weight: 600; color: SettingsColors.text; }
                                Text {
                                    text: root.dock-error ? "Could not save. Please try again." : "Off by default. Enable the Dock icon to open Settings.";
                                    font-size: 10.5px;
                                    color: root.dock-error ? SettingsColors.error : SettingsColors.secondary;
                                    wrap: word-wrap;
                                }
                            }
                            Switch {
                                checked: root.show-dock-icon;
                                accessible-label: "Show Agent Companion in the Dock";
                                toggled => { root.toggle-dock-icon(self.checked); }
                            }
                        }
                    }
                    Text {
                        text: "If all three are hidden, reopen Agent Companion from Applications to reach Settings.";
                        font-size: 10.5px;
                        color: SettingsColors.secondary;
                        wrap: word-wrap;
                    }
                    if root.dirty: SettingsCard {
                        vertical-stretch: 0;
                        background: SettingsColors.selected;
                        HorizontalLayout {
                            padding: 14px;
                            spacing: 16px;
                            Text {
                                text: "You have unapplied Codex CLI changes.";
                                font-size: 11px;
                                color: SettingsColors.accent;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Button {
                                text: "Review changes";
                                height: 28px;
                                clicked => { root.current-page = 0; }
                            }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                }
            }
            Tab {
                title: "Codex 双开";
                VerticalLayout {
                    padding-top: 20px;
                    spacing: 18px;
                    VerticalLayout {
                        spacing: 8px;
                        Text { text: "Codex 双开"; font-size: 16px; font-weight: 600; color: SettingsColors.text; }
                        Text {
                            text: "创建独立的 Dodex 环境，首次使用需要自行登录。任务按来源合并显示，用量和状态栏配置分别管理。";
                            font-size: 12px;
                            color: SettingsColors.secondary;
                            wrap: word-wrap;
                        }
                    }
                    SettingsCard {
                        vertical-stretch: 0;
                        VerticalLayout {
                            padding: 18px;
                            spacing: 14px;
                            Text {
                                text: root.dual-busy ? root.dual-phase : root.dual-deployed ? (root.dual-enabled ? "双开支持已启用" : "双开环境已部署 · 支持已停用") : "双开默认关闭";
                                font-size: 13px;
                                font-weight: 600;
                                color: SettingsColors.text;
                            }
                            Text {
                                text: root.dual-message;
                                font-size: 11px;
                                color: root.dual-error ? SettingsColors.error : SettingsColors.secondary;
                                wrap: word-wrap;
                            }
                            if !root.dual-deployed: Button {
                                text: root.dual-busy ? "正在检查与部署…" : root.dual-error ? "重试部署" : "部署双开环境";
                                enabled: !root.dual-busy;
                                primary: true;
                                accessible-label: "部署双开环境";
                                clicked => { root.deploy-dual(); }
                            }
                            if root.dual-deployed: HorizontalLayout {
                                spacing: 24px;
                                VerticalLayout {
                                    spacing: 5px;
                                    Text { text: "在 Companion 中启用双实例支持"; font-size: 12px; color: SettingsColors.text; }
                                    Text { text: "停用不会退出 Dodex，也不会删除环境。重新启用时会先验证部署。"; font-size: 10.5px; color: SettingsColors.secondary; wrap: word-wrap; }
                                }
                                Switch {
                                    checked: root.dual-enabled;
                                    enabled: !root.dual-busy;
                                    accessible-label: "启用 Codex 双实例支持";
                                    toggled => { root.toggle-dual(self.checked); }
                                }
                            }
                        }
                    }
                    if root.dual-deployed: SettingsCard {
                        vertical-stretch: 0;
                        VerticalLayout {
                            padding: 18px;
                            spacing: 8px;
                            Text { text: "使用 Dodex"; font-size: 12px; font-weight: 600; color: SettingsColors.text; }
                            Text { text: "在应用程序中打开 Dodex，首次使用请登录。部署完成不会自动启动 Dodex。"; font-size: 11px; color: SettingsColors.secondary; wrap: word-wrap; }
                        }
                    }
                    Text {
                        text: "部署使用本机已安装且签名有效的官方 Codex 应用。已有 Dodex 环境会先验证，程序、配置和数据不会被覆盖。全新环境不复制主实例的凭证、历史或个人配置。";
                        font-size: 11px;
                        color: SettingsColors.secondary;
                        wrap: word-wrap;
                    }
                    Rectangle { vertical-stretch: 1; }
                }
            }
        }
    }
}
