import { Button, CheckBox, ComboBox, Switch, ScrollView, TabWidget, Palette } from "std-widgets.slint";
import { StatusComponent } from "status-component.slint";

global SettingsColors {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <color> background: dark ? #1d201f : #f4f6f5;
    out property <color> card: dark ? #272b29 : #ffffff;
    out property <color> text: dark ? #f0f3f1 : #202925;
    out property <color> secondary: dark ? #a6b1ab : #65736b;
    out property <color> border: dark ? #3a413d : #e0e7e2;
    out property <color> selected: dark ? #293b33 : #edf7f0;
    out property <color> accent: dark ? #7adab0 : #27734e;
    out property <color> error: dark ? #ffb2a8 : #ad342b;
}

component SettingsCard inherits Rectangle {
    background: SettingsColors.card;
    border-radius: 12px;
    border-width: 1px;
    border-color: SettingsColors.border;
}

component ComponentChoice inherits Rectangle {
    in property <StatusComponent> item;
    in property <bool> available;
    callback toggle(string, bool);
    height: 38px;
    border-radius: 8px;
    background: root.item.selected ? SettingsColors.selected : SettingsColors.card;
    Tooltip { text: @markdown("\{root.item.description}"); }
    HorizontalLayout {
        padding: 10px;
        spacing: 8px;
        CheckBox {
            width: 16px;
            checked: root.item.selected;
            enabled: root.available;
            accessible-label: root.item.label;
            toggled => { root.toggle(root.item.id, self.checked); }
        }
        Rectangle {
            horizontal-stretch: 1;
            Text {
                width: parent.width;
                height: parent.height;
                text: root.item.label;
                color: root.available ? SettingsColors.text : SettingsColors.secondary;
                font-size: 12px;
                horizontal-alignment: left;
                vertical-alignment: center;
                overflow: elide;
            }
            TouchArea {
                enabled: root.available;
                mouse-cursor: pointer;
                clicked => { root.toggle(root.item.id, !root.item.selected); }
            }
        }
    }
}

export component MacSettings inherits Rectangle {
    in-out property <int> current-page: 0;
    in property <[StatusComponent]> left-components;
    in property <[StatusComponent]> right-components;
    in property <string> preview;
    in property <string> mono-font;
    in property <int> selected-count;
    in property <bool> ready;
    in property <bool> dirty;
    in property <bool> custom;
    in property <string> message;
    in property <bool> error;
    in property <string> config-path;
    in property <string> catalog-version;
    in property <bool> show-dock-icon;
    in property <bool> dock-error;
    in property <[string]> display-options;
    in-out property <int> selected-display;
    in property <string> display-status;
    in property <bool> display-error;
    callback select-display(string);
    callback toggle-dock-icon(bool);
    callback toggle(string, bool);
    callback apply();
    callback restore-defaults();

    background: SettingsColors.background;
    VerticalLayout {
        padding: 24px;
        spacing: 20px;
        HorizontalLayout {
            height: 44px;
            spacing: 12px;
            Rectangle {
                width: 40px;
                height: 40px;
                background: #172b22;
                border-radius: 11px;
                Text {
                    text: "›_";
                    font-family: root.mono-font;
                    font-size: 21px;
                    font-weight: 600;
                    color: #8de1b9;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 4px;
                Text { text: "Settings"; font-size: 23px; font-weight: 700; color: SettingsColors.text; }
                Text { text: "Make your workspace feel right."; font-size: 12px; color: SettingsColors.secondary; }
            }
            Text {
                text: "Agent Companion";
                font-size: 12px;
                color: SettingsColors.secondary;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }

        TabWidget {
            current-index <=> root.current-page;
            Tab {
                title: "Codex CLI";
                VerticalLayout {
                    padding-top: 20px;
                    spacing: 12px;
                    HorizontalLayout {
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "Status bar"; font-size: 18px; font-weight: 600; color: SettingsColors.text; }
                            Text { text: "Choose what appears at the bottom of your terminal."; font-size: 12px; color: SettingsColors.secondary; }
                        }
                        Text {
                            text: "LIVE PREVIEW";
                            color: SettingsColors.accent;
                            font-size: 10px;
                            font-weight: 600;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        height: 116px;
                        border-radius: 12px;
                        background: #141c18;
                        border-width: 1px;
                        border-color: #293a30;
                        VerticalLayout {
                            padding: 16px;
                            spacing: 10px;
                            HorizontalLayout {
                                Text { text: "›_ Codex CLI"; font-size: 12px; font-family: root.mono-font; color: #e3ede7; }
                                Text { text: "Sample values"; font-size: 10px; color: #a6b7ad; horizontal-alignment: right; }
                            }
                            Rectangle {
                                border-radius: 7px;
                                background: #223328;
                                VerticalLayout {
                                    padding: 12px;
                                    ScrollView {
                                        min-height: 0px;
                                        viewport-width: self.visible-width;
                                        horizontal-scrollbar-policy: always-off;
                                        VerticalLayout {
                                            alignment: start;
                                            Text {
                                                text: !root.ready ? "Preview unavailable" : root.selected-count == 0 ? "Status bar hidden" : root.preview;
                                                color: #9de2b9;
                                                font-family: root.mono-font;
                                                font-size: 12px;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        Text { text: "Components"; font-size: 13px; font-weight: 600; color: SettingsColors.text; }
                        Text {
                            text: root.ready ? root.selected-count + " selected" : "Unavailable";
                            color: SettingsColors.accent;
                            font-size: 11px;
                            horizontal-alignment: right;
                        }
                    }
                    SettingsCard {
                        vertical-stretch: 1;
                        min-height: 150px;
                        VerticalLayout {
                            padding: 8px;
                            ScrollView {
                                viewport-width: self.visible-width;
                                horizontal-scrollbar-policy: always-off;
                                HorizontalLayout {
                                    spacing: 8px;
                                    VerticalLayout {
                                        spacing: 4px;
                                        alignment: start;
                                        for item in root.left-components: ComponentChoice {
                                            item: item;
                                            available: root.ready;
                                            toggle(id, enabled) => { root.toggle(id, enabled); }
                                        }
                                    }
                                    VerticalLayout {
                                        spacing: 4px;
                                        alignment: start;
                                        for item in root.right-components: ComponentChoice {
                                            item: item;
                                            available: root.ready;
                                            toggle(id, enabled) => { root.toggle(id, enabled); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    SettingsCard {
                        vertical-stretch: 0;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 5px;
                            HorizontalLayout {
                                Text { text: "Configuration"; font-size: 11px; font-weight: 600; color: SettingsColors.text; }
                                Text {
                                    text: "Codex CLI " + root.catalog-version;
                                    font-size: 10px;
                                    color: SettingsColors.secondary;
                                    horizontal-alignment: right;
                                }
                            }
                            Text {
                                text: root.config-path;
                                font-family: root.mono-font;
                                font-size: 10px;
                                color: SettingsColors.secondary;
                                wrap: word-wrap;
                            }
                        }
                    }
                    Rectangle { height: 1px; background: SettingsColors.border; }
                    HorizontalLayout {
                        spacing: 12px;
                        Text {
                            text: root.dirty ? "Unapplied changes" : root.ready ? (root.custom ? "Custom status bar" : "Using Codex defaults") : "Configuration unavailable";
                            font-size: 12px;
                            color: root.dirty ? SettingsColors.accent : SettingsColors.secondary;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Button {
                            text: "Restore defaults";
                            height: 32px;
                            enabled: root.ready && (root.custom || root.dirty);
                            clicked => { root.restore-defaults(); }
                        }
                        Button {
                            text: "Apply changes";
                            height: 32px;
                            min-width: 108px;
                            primary: true;
                            enabled: root.ready && root.dirty;
                            clicked => { root.apply(); }
                        }
                    }
                    Text {
                        text: root.message;
                        font-size: 11px;
                        color: root.error ? SettingsColors.error : SettingsColors.secondary;
                        wrap: word-wrap;
                    }
                }
            }
            Tab {
                title: "Notch & app";
                VerticalLayout {
                    padding-top: 20px;
                    spacing: 18px;
                    VerticalLayout {
                        spacing: 5px;
                        Text { text: "Notch & app"; font-size: 18px; font-weight: 600; color: SettingsColors.text; }
                        Text { text: "Choose where your companion lives. Changes save automatically."; font-size: 12px; color: SettingsColors.secondary; }
                    }
                    Text { text: "Display"; font-size: 13px; font-weight: 600; color: SettingsColors.text; }
                    SettingsCard {
                        vertical-stretch: 0;
                        VerticalLayout {
                            padding: 18px;
                            spacing: 14px;
                            HorizontalLayout {
                                spacing: 24px;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 5px;
                                    Text { text: "Notch display"; font-size: 13px; font-weight: 600; color: SettingsColors.text; }
                                    Text { text: "Follow your main screen or choose a display."; font-size: 11px; color: SettingsColors.secondary; wrap: word-wrap; }
                                }
                                ComboBox {
                                    width: 340px;
                                    height: 32px;
                                    model: root.display-options;
                                    current-index <=> root.selected-display;
                                    enabled: root.display-options.length > 0;
                                    accessible-label: "Notch display";
                                    selected(label) => { root.select-display(label); }
                                }
                            }
                            Rectangle { height: 1px; background: SettingsColors.border; }
                            Text {
                                text: root.display-error ? "Could not save the display choice. Please try again." : root.display-status;
                                color: root.display-error ? SettingsColors.error : SettingsColors.secondary;
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                        }
                    }
                    Text { text: "App appearance"; font-size: 13px; font-weight: 600; color: SettingsColors.text; }
                    SettingsCard {
                        vertical-stretch: 0;
                        HorizontalLayout {
                            padding: 18px;
                            spacing: 24px;
                            VerticalLayout {
                                alignment: center;
                                spacing: 5px;
                                Text { text: "Show in Dock"; font-size: 13px; font-weight: 600; color: SettingsColors.text; }
                                Text {
                                    text: root.dock-error ? "Could not save. Please try again." : "When hidden, open Settings from the notch.";
                                    font-size: 11px;
                                    color: root.dock-error ? SettingsColors.error : SettingsColors.secondary;
                                    wrap: word-wrap;
                                }
                            }
                            Switch {
                                checked: root.show-dock-icon;
                                accessible-label: "Show Agent Companion in the Dock";
                                toggled => { root.toggle-dock-icon(self.checked); }
                            }
                        }
                    }
                    if root.dirty: SettingsCard {
                        vertical-stretch: 0;
                        background: SettingsColors.selected;
                        HorizontalLayout {
                            padding: 14px;
                            spacing: 16px;
                            Text {
                                text: "You have unapplied Codex CLI changes.";
                                font-size: 12px;
                                color: SettingsColors.accent;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Button {
                                text: "Review changes";
                                height: 28px;
                                clicked => { root.current-page = 0; }
                            }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                }
            }
        }
    }
}
