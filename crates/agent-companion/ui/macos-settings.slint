import { ComboBox, ScrollView, Switch } from "std-widgets.slint";
import { StatusComponent } from "status-component.slint";

import { SettingsColors, SettingsCard, SettingsButton, SettingsTextField } from "settings-common.slint";
import { StatusBarSettings } from "statusbar-settings.slint";
import { ProfileSyncFile, ProfileSyncSettings } from "profile-sync.slint";

export component MacSettings inherits Rectangle {
    in property <int> usage-refresh-minutes: 5;
    in property <string> usage-settings-message;
    callback set-usage-refresh-minutes(string);
    in-out property <int> current-page: 0;
    in property <[StatusComponent]> left-components;
    in property <[StatusComponent]> right-components;
    in property <string> preview;
    in property <string> mono-font;
    in property <int> selected-count;
    in property <bool> ready;
    in property <bool> dirty;
    in property <bool> custom;
    in property <string> message;
    in property <bool> error;
    in property <string> config-path;
    in property <string> catalog-version;
    in property <bool> dual-enabled;
    in property <bool> dual-deployed;
    in property <bool> dual-app-installed;
    in property <string> dual-app-path;
    in property <string> dual-app-version;
    in property <string> dual-profile-home;
    in property <bool> dual-tui-available;
    in property <bool> dual-busy;
    in property <bool> dual-error;
    in property <string> dual-phase;
    in property <string> dual-message;
    in property <[ProfileSyncFile]> sync-files;
    in property <bool> sync-busy;
    in property <string> sync-status;
    in property <bool> sync-error;
    in-out property <length> dual-scroll-y;
    in property <[string]> instance-options;
    in-out property <int> selected-instance;
    callback deploy-dual();
    callback toggle-dual(bool);
    callback select-instance(string);
    callback sync-profile(string, bool);
    callback open-sync-file(string, bool, bool);
    callback refresh-sync();
    callback toggle(string, bool);
    callback apply();
    callback restore-defaults();

    background: SettingsColors.background;
    VerticalLayout {
        padding: 24px;
        spacing: 16px;
        HorizontalLayout {
            height: 44px;
            spacing: 12px;
            Rectangle {
                width: 40px;
                height: 40px;
                background: #172b22;
                border-radius: 11px;
                Text {
                    text: "›_";
                    font-family: root.mono-font;
                    font-size: 21px;
                    font-weight: 600;
                    color: #8de1b9;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 4px;
                Text { text: "设置"; font-size: 24px; font-weight: 600; color: SettingsColors.text; }
                Text { text: "管理实例与工作偏好"; font-size: 12px; color: SettingsColors.secondary; }
            }
            Text {
                text: "Agent Companion";
                font-size: 12px;
                color: SettingsColors.secondary;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }

        SettingsCard {
            vertical-stretch: 0;
            HorizontalLayout {
                padding: 16px;
                spacing: 16px;
                VerticalLayout {
                    spacing: 4px;
                    Text { text: "额度自动刷新间隔（分钟）"; font-size: 12px; color: SettingsColors.text; }
                    Text {
                        text: root.usage-settings-message == "" ? "所有实例共用，1–60 分钟；保存后重新计时。" : root.usage-settings-message;
                        wrap: word-wrap;
                        font-size: 12px;
                        color: SettingsColors.secondary;
                    }
                }
                usage-interval := SettingsTextField {
                    width: 72px;
                    height: 32px;
                    text: root.usage-refresh-minutes;
                    accessible-label: "额度自动刷新间隔（分钟）";
                    accepted => { root.set-usage-refresh-minutes(self.text); }
                }
                SettingsButton {
                    width: 80px;
                    text: "保存";
                    clicked => { root.set-usage-refresh-minutes(usage-interval.text); }
                }
            }
        }

        HorizontalLayout {
            height: 32px;
            spacing: 8px;
            SettingsButton { text: "Codex CLI"; width: 132px; primary: root.current-page == 0; clicked => { root.current-page = 0; } }
            SettingsButton { text: "Codex 双开"; width: 132px; primary: root.current-page == 1; clicked => { root.current-page = 1; } }
            Rectangle { horizontal-stretch: 1; }
        }
        Rectangle {
            vertical-stretch: 1;
            if root.current-page == 0: VerticalLayout {
                    padding-top: 4px;
                    spacing: 10px;
                    if root.dual-enabled: HorizontalLayout {
                        height: 30px;
                        spacing: 12px;
                        Text { text: "Instance"; font-size: 12px; color: SettingsColors.secondary; vertical-alignment: center; }
                        ComboBox {
                            width: 180px;
                            model: root.instance-options;
                            current-index <=> root.selected-instance;
                            accessible-label: "Status bar configuration instance";
                            selected(label) => { root.select-instance(label); }
                        }
                        Text { text: "Each instance keeps its own draft and saved settings."; font-size: 12px; color: SettingsColors.secondary; vertical-alignment: center; }
                    }
                    StatusBarSettings {
                        left-components: root.left-components;
                        right-components: root.right-components;
                        preview: root.preview;
                        mono-font: root.mono-font;
                        selected-count: root.selected-count;
                        ready: root.ready && !root.sync-busy;
                        dirty: root.dirty;
                        custom: root.custom;
                        message: root.message;
                        error: root.error;
                        config-path: root.config-path;
                        catalog-version: root.catalog-version;
                        toggle(id, enabled) => { root.toggle(id, enabled); }
                        apply => { root.apply(); }
                        restore-defaults => { root.restore-defaults(); }
                    }
            }
            if root.current-page == 1: ScrollView {
                    viewport-width: self.visible-width;
                    viewport-y <=> root.dual-scroll-y;
                    horizontal-scrollbar-policy: always-off;
                    changed viewport-y => {
                        self.viewport-y = max(min(self.viewport-y, 0px), min(0px, self.visible-height - self.viewport-height));
                    }
                    changed viewport-height => {
                        self.viewport-y = max(min(self.viewport-y, 0px), min(0px, self.visible-height - self.viewport-height));
                    }
                VerticalLayout {
                    padding-top: 4px;
                    padding-right: 12px;
                    padding-bottom: 8px;
                    spacing: 20px;
                    VerticalLayout {
                        spacing: 8px;
                        Text { text: "Codex 双开"; font-size: 16px; font-weight: 600; color: SettingsColors.text; }
                        if root.dual-busy || root.dual-message != "": Text {
                            text: root.dual-busy ? root.dual-phase : root.dual-message;
                            font-size: 12px;
                            color: !root.dual-busy && root.dual-error ? SettingsColors.error : SettingsColors.secondary;
                            wrap: word-wrap;
                        }
                    }
                    SettingsCard {
                        vertical-stretch: 0;
                        VerticalLayout {
                            padding: 18px;
                            spacing: 10px;
                            HorizontalLayout {
                                Text { text: "Dodex App"; font-size: 13px; font-weight: 600; color: SettingsColors.text; }
                                Text {
                                    text: root.dual-app-installed ? "已安装" : "未安装";
                                    font-size: 12px;
                                    color: root.dual-app-installed ? SettingsColors.accent : SettingsColors.secondary;
                                    horizontal-alignment: right;
                                }
                            }
                            if root.dual-app-installed && root.dual-app-version != "": Text {
                                text: "已同步版本：" + root.dual-app-version;
                                font-size: 12px;
                                color: SettingsColors.secondary;
                                wrap: word-wrap;
                            }
                            if root.dual-app-installed && root.dual-app-path != "": Text {
                                text: root.dual-app-path;
                                font-size: 12px;
                                color: SettingsColors.secondary;
                                wrap: word-wrap;
                            }
                            if !root.dual-app-installed: Text {
                                text: "从本机 Codex 安装 Dodex，可在应用程序或 Dock 中打开。";
                                font-size: 12px;
                                color: SettingsColors.secondary;
                                wrap: word-wrap;
                            }
                            Text {
                                text: "启动 Dodex 时自动检查本机 Codex，版本变化后同步 App。";
                                font-size: 12px;
                                color: SettingsColors.secondary;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                SettingsButton {
                                    text: root.dual-busy ? "处理中…" : root.dual-app-installed ? "检查并同步" : "安装 Dodex App";
                                    enabled: !root.dual-busy;
                                    primary: true;
                                    accessible-label: root.dual-app-installed ? "从本机 Codex 检查并同步 Dodex App" : "从本机 Codex 安装 Dodex App";
                                    clicked => { root.deploy-dual(); }
                                }
                                if root.dual-app-installed: Text {
                                    text: "手动同步前请退出 Dodex。";
                                    font-size: 12px;
                                    color: SettingsColors.secondary;
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }
                    }
                    SettingsCard {
                        vertical-stretch: 0;
                        VerticalLayout {
                            padding: 18px;
                            spacing: 10px;
                            HorizontalLayout {
                                spacing: 24px;
                                VerticalLayout {
                                    spacing: 5px;
                                    Text { text: "Companion 接入"; font-size: 13px; font-weight: 600; color: SettingsColors.text; }
                                    Text { text: "任务合并显示，额度与状态栏配置按账号分别管理。"; font-size: 12px; color: SettingsColors.secondary; wrap: word-wrap; }
                                }
                                Switch {
                                    checked: root.dual-enabled;
                                    enabled: !root.dual-busy && (root.dual-tui-available || root.dual-enabled);
                                    accessible-label: "在 Companion 中接入 Dodex 副账号";
                                    toggled => { root.toggle-dual(self.checked); }
                                }
                            }
                            Text {
                                text: !root.dual-tui-available && !root.dual-enabled
                                    ? "需要副账号 CLI 程序才能启用接入。"
                                    : root.dual-enabled ? "已启用。关闭后，Dodex 仍可照常使用。" : "已关闭。Dodex 可独立使用。";
                                font-size: 12px;
                                color: SettingsColors.secondary;
                                wrap: word-wrap;
                            }
                        }
                    }
                    SettingsCard {
                        vertical-stretch: 0;
                        VerticalLayout {
                            padding: 18px;
                            spacing: 8px;
                            Text { text: "副账号与 TUI"; font-size: 13px; font-weight: 600; color: SettingsColors.text; }
                            Text {
                                text: "Dodex App 与已有 TUI 共用副账号目录、登录和会话。TUI 单独安装和更新。";
                                font-size: 12px;
                                color: SettingsColors.secondary;
                                wrap: word-wrap;
                            }
                            if root.dual-profile-home != "": Rectangle {
                                height: 32px;
                                border-radius: 7px;
                                border-width: 1px;
                                border-color: SettingsColors.border;
                                background: SettingsColors.background;
                                Tooltip { text: @markdown("副账号目录：\{root.dual-profile-home}"); }
                                TextInput {
                                    x: 10px;
                                    width: parent.width - 20px;
                                    height: parent.height;
                                    text: root.dual-profile-home;
                                    read-only: true;
                                    single-line: true;
                                    font-size: 12px;
                                    color: SettingsColors.text;
                                    vertical-alignment: center;
                                    accessible-label: "副账号目录，可选择复制";
                                }
                            }
                            if root.dual-profile-home == "": Text {
                                text: "安装后显示副账号目录；首次使用需要登录。";
                                font-size: 12px;
                                color: SettingsColors.secondary;
                                wrap: word-wrap;
                            }
                            Text {
                                text: root.dual-tui-available ? "已检测到副账号 CLI 程序。" : "未检测到副账号 CLI 程序；本页只安装或更新 App。";
                                font-size: 12px;
                                color: SettingsColors.secondary;
                                wrap: word-wrap;
                            }
                        }
                    }
                    ProfileSyncSettings {
                        section-title: "手动同步配置";
                        description: "Codex 与 Dodex 的账号配置仅手动复制，不随 App 自动更新。";
                        primary-label: "Codex（主账号）";
                        secondary-label: "Dodex（副账号）";
                        files: root.sync-files;
                        busy: root.dual-busy || root.sync-busy;
                        status: root.sync-status;
                        error: root.sync-error;
                        sync(file, to-secondary) => { root.sync-profile(file, to-secondary); }
                        open-file(file, secondary, edit) => { root.open-sync-file(file, secondary, edit); }
                        refresh => { root.refresh-sync(); }
                    }
                }
            }
        }
    }
}
