import { Button, ScrollView } from "std-widgets.slint";
import { StatusComponent } from "status-component.slint";
import { SettingsColors, SettingsCard, ComponentChoice } from "settings-common.slint";

export component StatusBarSettings inherits Rectangle {
    in property <[StatusComponent]> left-components;
    in property <[StatusComponent]> right-components;
    in property <string> preview;
    in property <string> mono-font;
    in property <int> selected-count;
    in property <bool> ready;
    in property <bool> dirty;
    in property <bool> custom;
    in property <string> message;
    in property <bool> error;
    in property <string> config-path;
    in property <string> catalog-version;
    callback toggle(string, bool);
    callback apply();
    callback restore-defaults();
    VerticalLayout {
        spacing: 12px;
        HorizontalLayout {
            VerticalLayout {
                spacing: 4px;
                Text { text: "Status bar"; font-size: 16px; font-weight: 600; color: SettingsColors.text; }
                Text { text: "Choose what appears at the bottom of your terminal."; font-size: 11px; color: SettingsColors.secondary; }
            }
            Text {
                text: "LIVE PREVIEW";
                color: SettingsColors.accent;
                font-size: 10px;
                font-weight: 600;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }
        Rectangle {
            height: 104px;
            border-radius: 12px;
            background: #141c18;
            border-width: 1px;
            border-color: #293a30;
            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                HorizontalLayout {
                    Text { text: "›_ Codex CLI"; font-size: 11px; font-family: root.mono-font; color: #e3ede7; }
                    Text { text: "Sample values"; font-size: 10px; color: #a6b7ad; horizontal-alignment: right; }
                }
                Rectangle {
                    border-radius: 7px;
                    background: #223328;
                    VerticalLayout {
                        padding: 12px;
                        ScrollView {
                            min-height: 0px;
                            viewport-width: self.visible-width;
                            horizontal-scrollbar-policy: always-off;
                            VerticalLayout {
                                alignment: start;
                                Text {
                                    text: !root.ready ? "Preview unavailable" : root.selected-count == 0 ? "Status bar hidden" : root.preview;
                                    color: #9de2b9;
                                    font-family: root.mono-font;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }
            }
        }
        HorizontalLayout {
            Text { text: "Components"; font-size: 12px; font-weight: 600; color: SettingsColors.text; }
            Text {
                text: root.ready ? root.selected-count + " selected" : "Unavailable";
                color: SettingsColors.accent;
                font-size: 10.5px;
                horizontal-alignment: right;
            }
        }
        SettingsCard {
            vertical-stretch: 1;
            min-height: 150px;
            VerticalLayout {
                padding: 8px;
                ScrollView {
                    viewport-width: self.visible-width;
                    horizontal-scrollbar-policy: always-off;
                    HorizontalLayout {
                        spacing: 8px;
                        VerticalLayout {
                            spacing: 4px;
                            alignment: start;
                            for item in root.left-components: ComponentChoice {
                                item: item;
                                available: root.ready;
                                toggle(id, enabled) => { root.toggle(id, enabled); }
                            }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            alignment: start;
                            for item in root.right-components: ComponentChoice {
                                item: item;
                                available: root.ready;
                                toggle(id, enabled) => { root.toggle(id, enabled); }
                            }
                        }
                    }
                }
            }
        }
        SettingsCard {
            vertical-stretch: 0;
            VerticalLayout {
                padding: 12px;
                spacing: 5px;
                HorizontalLayout {
                    Text { text: "Configuration"; font-size: 10.5px; font-weight: 600; color: SettingsColors.text; }
                    Text {
                        text: "Codex CLI " + root.catalog-version;
                        font-size: 10px;
                        color: SettingsColors.secondary;
                        horizontal-alignment: right;
                    }
                }
                Text {
                    text: root.config-path;
                    font-family: root.mono-font;
                    font-size: 10px;
                    color: SettingsColors.secondary;
                    wrap: word-wrap;
                }
            }
        }
        Rectangle { height: 1px; background: SettingsColors.border; }
        HorizontalLayout {
            spacing: 12px;
            Text {
                text: root.dirty ? "Unapplied changes" : root.ready ? (root.custom ? "Custom status bar" : "Using Codex defaults") : "Configuration unavailable";
                font-size: 11px;
                color: root.dirty ? SettingsColors.accent : SettingsColors.secondary;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: "Restore defaults";
                height: 32px;
                enabled: root.ready && (root.custom || root.dirty);
                clicked => { root.restore-defaults(); }
            }
            Button {
                text: "Apply changes";
                height: 32px;
                min-width: 108px;
                primary: true;
                enabled: root.ready && root.dirty;
                clicked => { root.apply(); }
            }
        }
        Text {
            text: root.message;
            font-size: 10.5px;
            color: root.error ? SettingsColors.error : SettingsColors.secondary;
            wrap: word-wrap;
        }
    }
}
