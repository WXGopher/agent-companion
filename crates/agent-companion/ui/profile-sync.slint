import { SettingsColors, SettingsCard, SettingsButton } from "settings-common.slint";

export struct ProfileSyncFile {
    key: string,
    title: string,
    primary-path: string,
    secondary-path: string,
    primary-exists: bool,
    secondary-exists: bool,
    to-secondary: bool,
    to-primary: bool,
    note: string,
    message: string,
    error: bool,
    backup-path: string,
}

// A selectable path uses the same field surface and height as nearby controls.
component PathField inherits Rectangle {
    in property <string> text;
    in property <string> label;
    public function copy-path() { input.select-all(); input.copy(); }
    height: 32px;
    horizontal-stretch: 1;
    min-width: 100px;
    border-radius: 7px;
    background: SettingsColors.background;
    border-width: 1px;
    border-color: SettingsColors.border;
    Tooltip { text: @markdown("\{root.text}"); }
    input := TextInput {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        text: root.text;
        read-only: true;
        single-line: true;
        font-size: 12px;
        color: SettingsColors.text;
        vertical-alignment: center;
        accessible-label: root.label;
    }
}

component FilePath inherits VerticalLayout {
    in property <string> label;
    in property <string> path;
    in property <bool> exists;
    in property <bool> busy;
    callback open(bool);
    spacing: 7px;
    HorizontalLayout {
        Text { text: root.label; font-size: 12px; font-weight: 500; color: SettingsColors.text; }
        Text {
            text: root.path == "" ? "部署后显示路径" : root.exists ? "已存在" : "尚未创建";
            font-size: 12px;
            color: SettingsColors.secondary;
            horizontal-alignment: right;
        }
    }
    HorizontalLayout {
        spacing: 8px;
        path := PathField {
            text: root.path;
            label: root.label + " 完整文件路径，可选择复制";
        }
        SettingsButton {
            text: "复制";
            enabled: root.path != "";
            accessible-label: "复制 " + root.label + " 路径";
            clicked => { path.copy-path(); }
        }
        SettingsButton {
            text: "定位";
            enabled: root.path != "";
            accessible-label: "定位 " + root.label + " 文件或所在目录";
            clicked => { root.open(false); }
        }
        SettingsButton {
            text: "编辑";
            enabled: root.exists && !root.busy;
            accessible-label: "编辑 " + root.label;
            clicked => { root.open(true); }
        }
    }
}

export component ProfileSyncSettings inherits VerticalLayout {
    in property <string> section-title: "配置与全局指令";
    in property <string> description;
    in property <string> primary-label: "Codex";
    in property <string> secondary-label: "Dodex";
    in property <[ProfileSyncFile]> files;
    in property <bool> busy;
    in property <string> status;
    in property <bool> error;
    callback sync(string, bool);
    callback open-file(string, bool, bool);
    callback refresh();
    spacing: 16px;
    HorizontalLayout {
        Text { text: root.section-title; font-size: 17px; font-weight: 600; color: SettingsColors.text; vertical-alignment: center; }
        Rectangle { horizontal-stretch: 1; }
        SettingsButton { text: "刷新状态"; accessible-label: "刷新文件状态"; enabled: !root.busy; clicked => { root.refresh(); } }
    }
    if root.description != "": Text {
        text: root.description;
        font-size: 12px;
        color: SettingsColors.secondary;
        wrap: word-wrap;
    }
    Text {
        text: root.status != "" ? root.status : "每次手动选择覆盖方向；不会自动同步或建立链接。目标文件存在时会先备份。";
        font-size: 12px;
        color: root.error ? SettingsColors.error : SettingsColors.secondary;
        wrap: word-wrap;
    }
    for file in root.files: SettingsCard {
        vertical-stretch: 0;
        VerticalLayout {
            padding: 20px;
            spacing: 14px;
            Text { text: file.title; font-size: 15px; font-weight: 600; color: SettingsColors.text; }
            Text {
                text: file.key == "config"
                    ? "覆盖时包含配置内的 API Key / Token，请确认方向。auth.json 不会复制，目标实例的登录存储、数据库和日志设置会保留。"
                    : "仅同步各自 CODEX_HOME 下的 AGENTS.md（全局指令），不涉及项目内的指令文件。";
                font-size: 12px;
                color: SettingsColors.secondary;
                wrap: word-wrap;
            }
            FilePath {
                label: root.primary-label + " · " + file.title;
                path: file.primary-path;
                exists: file.primary-exists;
                busy: root.busy;
                open(edit) => { root.open-file(file.key, false, edit); }
            }
            FilePath {
                label: root.secondary-label + " · " + file.title;
                path: file.secondary-path;
                exists: file.secondary-exists;
                busy: root.busy;
                open(edit) => { root.open-file(file.key, true, edit); }
            }
            if file.note != "": Text {
                text: file.note;
                font-size: 12px;
                color: SettingsColors.secondary;
                wrap: word-wrap;
            }
            Rectangle { height: 1px; background: SettingsColors.border; }
            HorizontalLayout {
                spacing: 8px;
                Text { text: "覆盖方向"; font-size: 12px; color: SettingsColors.secondary; vertical-alignment: center; }
                SettingsButton {
                    text: root.primary-label + " → " + root.secondary-label;
                    Tooltip { text: @markdown("覆盖 \{root.secondary-label} 的文件，原文件会先备份。"); }
                    enabled: file.to-secondary && !root.busy;
                    accessible-label: file.title + "：" + root.primary-label + " 覆盖到 " + root.secondary-label;
                    clicked => { root.sync(file.key, true); }
                }
                SettingsButton {
                    text: root.secondary-label + " → " + root.primary-label;
                    Tooltip { text: @markdown("覆盖 \{root.primary-label} 的文件，原文件会先备份。"); }
                    enabled: file.to-primary && !root.busy;
                    accessible-label: file.title + "：" + root.secondary-label + " 覆盖到 " + root.primary-label;
                    clicked => { root.sync(file.key, false); }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            if file.message != "": Text {
                text: file.message;
                font-size: 12px;
                color: file.error ? SettingsColors.error : SettingsColors.accent;
                wrap: word-wrap;
            }
            if file.backup-path != "": VerticalLayout {
                spacing: 4px;
                Text { text: "覆盖前备份（可选择复制路径）"; font-size: 12px; color: SettingsColors.secondary; }
                PathField { text: file.backup-path; label: file.title + " 覆盖前备份路径"; }
            }
        }
    }
}
