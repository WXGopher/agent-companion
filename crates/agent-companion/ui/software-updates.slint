import { SettingsButton, SettingsCard, SettingsColors } from "settings-common.slint";
export struct SoftwareVersion { name: string, current: string, target: string, message: string, error: bool, }
export component SoftwareUpdates inherits SettingsCard {
    in property <[SoftwareVersion]> versions;
    in property <bool> busy;
    in property <bool> blocked;
    in property <bool> available: true;
    in property <bool> error;
    in property <string> message;
    in property <string> notice;
    callback maintain(string);
    vertical-stretch: 0;
    VerticalLayout {
        padding: 18px;
        spacing: 12px;
        Text { text: "TUI 版本与更新"; font-size: 15px; font-weight: 600; color: SettingsColors.text; }
        Text { text: "Codex 保留原安装渠道，Dodex 使用独立官方 standalone 包。每次仅更新所选实例。"; font-size: 12px; color: SettingsColors.secondary; wrap: word-wrap; }
        for version[index] in root.versions: VerticalLayout {
            spacing: 6px;
            Rectangle { height: 1px; background: SettingsColors.border; }
            HorizontalLayout {
                spacing: 12px;
                Text { width: 92px; text: version.name; font-weight: 600; font-size: 12px; color: SettingsColors.text; vertical-alignment: center; }
                Text { text: version.current + " · " + version.target; font-size: 12px; color: SettingsColors.secondary; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; }
                SettingsButton {
                    text: index == 0 ? "更新 Codex" : "更新 Dodex";
                    accessible-label: index == 0 ? "仅更新 Codex TUI，保留 Dodex 版本" : "仅更新 Dodex TUI，保留 Codex 版本";
                    enabled: !root.busy && !root.blocked && (index == 0 || root.available);
                    clicked => { root.maintain(index == 0 ? "update-codex" : "update-dodex"); }
                }
            }
            if version.message != "": Text { text: version.message; font-size: 11px; color: version.error ? SettingsColors.error : SettingsColors.secondary; wrap: word-wrap; }
        }
        if root.message != "": Text { text: root.message; font-size: 12px; color: root.error ? SettingsColors.error : SettingsColors.secondary; wrap: word-wrap; }
        if root.notice != "": Text { text: root.notice; font-size: 12px; color: SettingsColors.error; wrap: word-wrap; }
    }
}
