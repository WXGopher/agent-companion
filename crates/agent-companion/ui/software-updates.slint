import { SettingsButton, SettingsCard, SettingsColors } from "settings-common.slint";

export struct SoftwareVersion {
    name: string,
    current: string,
    target: string,
    message: string,
    error: bool,
}

export component SoftwareUpdates inherits SettingsCard {
    in property <[SoftwareVersion]> versions;
    in property <bool> busy;
    in property <bool> error;
    in property <string> message;
    in property <string> notice;
    callback maintain(string);
    vertical-stretch: 0;
    VerticalLayout {
        padding: 18px;
        spacing: 12px;
        Text { text: "版本管理"; font-size: 15px; font-weight: 600; color: SettingsColors.text; }
        Text {
            text: "对齐以本机 Codex 为准；全部更新检查官方稳定版，再分别对齐 TUI 和 App。较新的 Dodex 不会自动降级。";
            font-size: 12px; color: SettingsColors.secondary; wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 10px;
            SettingsButton { text: "对齐 Codex/Dodex 版本"; enabled: !root.busy; clicked => { root.maintain("align"); } }
            SettingsButton { text: "全部更新到最新"; primary: true; enabled: !root.busy; clicked => { root.maintain("update-all"); } }
            Rectangle { horizontal-stretch: 1; }
        }
        for version in root.versions: VerticalLayout {
            spacing: 4px;
            Rectangle { height: 1px; background: SettingsColors.border; }
            HorizontalLayout {
                spacing: 12px;
                Text { width: 92px; text: version.name; font-weight: 600; font-size: 12px; color: SettingsColors.text; }
                Text { text: "当前：" + version.current; font-size: 12px; color: SettingsColors.secondary; wrap: word-wrap; }
                Text { text: "目标：" + version.target; font-size: 12px; color: SettingsColors.secondary; wrap: word-wrap; }
            }
            if version.message != "": Text { text: version.message; font-size: 11px; color: version.error ? SettingsColors.error : SettingsColors.secondary; wrap: word-wrap; }
        }
        if root.message != "": Text {
            text: root.message;
            font-size: 12px; color: root.error ? SettingsColors.error : SettingsColors.secondary; wrap: word-wrap;
        }
        if root.notice != "": Text { text: root.notice; font-size: 12px; color: SettingsColors.error; wrap: word-wrap; }
        Text {
            text: "检查与下载在后台进行。替换前须自行退出 Codex / Dodex App 和 TUI；不会结束或重启进程。账号、配置和会话目录保持原样。";
            font-size: 11px; color: SettingsColors.secondary; wrap: word-wrap;
        }
    }
}
