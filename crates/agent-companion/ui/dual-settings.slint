import { ScrollView, Switch } from "std-widgets.slint";
import { SettingsButton, SettingsCard, SettingsColors } from "settings-common.slint";
import { DualSetup } from "dual-setup.slint";
import { ProfileSyncFile, ProfileSyncSettings } from "profile-sync.slint";
import { SoftwareVersion, SoftwareUpdates } from "software-updates.slint";

export component DualSettings inherits Rectangle {
    in property <bool> app-installed;
    in property <string> app-path;
    in property <string> app-version;
    in property <string> profile-home;
    in property <bool> tui-available;
    in property <bool> tui-configured;
    in property <bool> monitored;
    in property <bool> busy;
    in property <bool> error;
    in property <string> phase;
    in property <string> message;
    in property <[SoftwareVersion]> versions;
    in property <bool> software-busy;
    in property <bool> software-error;
    in property <string> software-message;
    in property <string> software-notice;
    in property <[ProfileSyncFile]> sync-files;
    in property <bool> sync-busy;
    in property <string> sync-status;
    in property <bool> sync-error;
    in-out property <length> scroll-y;
    in-out property <bool> advanced-open;
    callback setup();
    callback open();
    callback monitor(bool);
    callback maintain(string);
    callback sync-profile(string, bool);
    callback open-sync-file(string, bool, bool);
    callback refresh-sync();

    ScrollView {
        viewport-width: self.visible-width;
        viewport-y <=> root.scroll-y;
        horizontal-scrollbar-policy: always-off;
        changed viewport-y => {
            self.viewport-y = max(min(self.viewport-y, 0px), min(0px, self.visible-height - self.viewport-height));
        }
        changed viewport-height => {
            self.viewport-y = max(min(self.viewport-y, 0px), min(0px, self.visible-height - self.viewport-height));
        }
        VerticalLayout {
            padding-top: 4px;
            padding-right: 12px;
            padding-bottom: 8px;
            spacing: 16px;
            alignment: start;
            DualSetup {
                app-installed: root.app-installed;
                tui-available: root.tui-configured;
                monitored: root.monitored;
                busy: root.busy && !root.sync-busy;
                blocked: root.software-busy || root.sync-busy;
                error: root.error;
                phase: root.phase;
                message: root.message;
                setup => { root.setup(); }
                open => { root.open(); }
            }
            SoftwareUpdates {
                versions: root.versions;
                available: root.app-installed && root.tui-configured;
                busy: root.software-busy;
                blocked: root.busy || root.sync-busy;
                error: root.software-error;
                message: root.software-message;
                notice: root.software-notice;
                maintain(action) => { root.maintain(action); }
            }
            HorizontalLayout {
                SettingsButton {
                    text: root.advanced-open ? "收起高级设置" : "高级设置…";
                    accessible-label: root.advanced-open ? "收起双开高级设置" : "显示双开高级设置";
                    clicked => { root.advanced-open = !root.advanced-open; }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            if root.advanced-open: VerticalLayout {
                spacing: 16px;
                SettingsCard {
                    vertical-stretch: 0;
                    VerticalLayout {
                        padding: 18px;
                        spacing: 10px;
                        HorizontalLayout {
                            Text { text: "Companion 接入"; font-size: 13px; font-weight: 600; color: SettingsColors.text; vertical-alignment: center; }
                            Switch {
                                checked: root.monitored;
                                enabled: !root.busy && !root.software-busy && !root.sync-busy && (root.tui-available || root.monitored);
                                accessible-label: "在 Companion 中接入 Dodex 副账号";
                                toggled => { root.monitor(self.checked); }
                            }
                        }
                        Text { text: "安装时自动启用。关闭后停止 Companion 监控，Dodex 的登录、配置和会话仍保留。"; font-size: 12px; color: SettingsColors.secondary; wrap: word-wrap; }
                        if root.app-path != "": Text { text: "App：" + root.app-path; font-size: 12px; color: SettingsColors.secondary; wrap: word-wrap; }
                        if root.app-version != "": Text { text: "Dodex App 版本：" + root.app-version; font-size: 12px; color: SettingsColors.secondary; wrap: word-wrap; }
                        if root.profile-home != "": Rectangle {
                            height: 32px;
                            border-radius: 7px;
                            border-width: 1px;
                            border-color: SettingsColors.border;
                            background: SettingsColors.background;
                            TextInput {
                                x: 10px;
                                width: parent.width - 20px;
                                height: parent.height;
                                text: root.profile-home;
                                read-only: true;
                                single-line: true;
                                font-size: 12px;
                                color: SettingsColors.text;
                                vertical-alignment: center;
                                accessible-label: "副账号目录，可选择复制";
                            }
                        }
                    }
                }
                ProfileSyncSettings {
                    section-title: "手动同步配置与指令";
                    description: "按需复制 config.toml 或 AGENTS.md；安装不会自动复制这些文件，登录信息始终保留在各自账号。";
                    primary-label: "Codex（主账号）";
                    secondary-label: "Dodex（副账号）";
                    files: root.sync-files;
                    busy: root.busy || root.sync-busy || root.software-busy;
                    status: root.sync-status;
                    error: root.sync-error;
                    sync(file, to-secondary) => { root.sync-profile(file, to-secondary); }
                    open-file(file, secondary, edit) => { root.open-sync-file(file, secondary, edit); }
                    refresh => { root.refresh-sync(); }
                }
                SettingsCard {
                    vertical-stretch: 0;
                    VerticalLayout {
                        padding: 18px;
                        spacing: 10px;
                        Text { text: "更新主程序"; font-size: 13px; font-weight: 600; color: SettingsColors.text; }
                        Text { text: "联网更新 Codex 至官方稳定版，再分别对齐 Dodex App 和 TUI。更新前请退出需要替换的应用与终端会话。"; font-size: 12px; color: SettingsColors.secondary; wrap: word-wrap; }
                        HorizontalLayout {
                            SettingsButton {
                                text: "全部更新到最新";
                                enabled: !root.busy && !root.software-busy && !root.sync-busy;
                                clicked => { root.maintain("update-all"); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                    }
                }
            }
        }
    }
}
