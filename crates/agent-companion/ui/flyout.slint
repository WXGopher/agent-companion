import { ScrollView } from "std-widgets.slint";
import { Theme, SessionRow, SessionBlock, UsageRow } from "common.slint";
import { SubscriptionView, UsageDay, SubscriptionContent, QuotaRows } from "subscription.slint";

component PanelButton inherits FocusScope {
    in property <string> label;
    in property <bool> selected;
    in property <bool> available: true;
    callback clicked();
    height: 28px;
    min-width: 64px;
    enabled: root.available;
    accessible-role: button;
    accessible-label: root.label;
    key-pressed(event) => {
        if (event.text == " " || event.text == "\n") && root.available {
            root.clicked();
            return accept;
        }
        return reject;
    }
    Rectangle {
        border-radius: 7px;
        background: root.selected ? Theme.soft-hot : touch.has-hover ? Theme.soft : transparent;
        border-width: root.has-focus ? 1px : 0px;
        border-color: Theme.plenty;
        opacity: root.available ? 1 : 0.45;
        Text { text: root.label; color: root.selected ? Theme.text : Theme.dim; font-size: 11px; font-weight: root.selected ? 600 : 400; horizontal-alignment: center; vertical-alignment: center; }
        touch := TouchArea {
            enabled: root.available;
            mouse-cursor: pointer;
            clicked => { root.focus(); root.clicked(); }
        }
    }
}

component SessionList inherits VerticalLayout {
    in property <[SessionRow]> sessions;
    in property <bool> pulse;
    callback jump(string);
    spacing: 9px;
    for session in root.sessions: Rectangle {
        height: 32px;
        border-radius: 6px;
        background: session.jumpable && touch.has-hover
            ? Theme.soft
            : transparent;
        animate background { duration: 120ms; }

        touch := TouchArea {
            mouse-cursor: session.jumpable ? pointer : default;
            clicked => {
                if (session.jumpable) {
                    root.jump(session.id);
                }
            }
        }

        HorizontalLayout {
            spacing: 10px;

            Rectangle {
                width: 10px;
                SessionBlock {
                    y: 11px;
                    size: 10px;
                    phase: session.phase;
                    source: session.source;
                    pulse: root.pulse;
                }
            }

            VerticalLayout {
                spacing: 2px;
                alignment: center;
                Text {
                    text: session.title;
                    color: Theme.text;
                    font-size: 12px;
                    overflow: elide;
                }
                Text {
                    text: session.detail;
                    // Waiting on the human keeps its amber even
                    // here, so the row that wants a click looks
                    // like it.
                    color: session.phase == "waitingForApproval" || session.phase == "waitingForAnswer"
                        ? Theme.status-waiting
                        : Theme.faint;
                    font-size: 11px;
                    overflow: elide;
                }
            }

            // The door's handle: an arrow that brightens under the
            // pointer. Only drawn when the jump can actually work.
            if session.jumpable: Rectangle {
                width: 13px;
                horizontal-stretch: 0;
                Path {
                    y: (parent.height - 11px) / 2;
                    width: 11px;
                    height: 11px;
                    viewbox-width: 12;
                    viewbox-height: 12;
                    stroke: touch.has-hover ? Theme.body-text : Theme.faint;
                    stroke-width: 1.5px;
                    opacity: touch.has-hover ? 1.0 : 0.55;
                    commands: "M 3 9 L 9 3 M 4.5 3 L 9 3 L 9 7.5";
                }
            }
        }
    }
}

export component FlyoutWindow inherits Window {
    title: "Agent Companion Sessions";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    default-font-family: "Microsoft YaHei UI";
    in property <[SessionRow]> sessions;
    in property <bool> compact;
    in property <int> waiting-total;
    in property <int> active-count;
    in property <int> finished-count;
    in-out property <bool> finished;
    in-out property <bool> usage-page;
    in-out property <length> task-scroll-y;
    in-out property <length> usage-scroll-y;
    in property <[UsageRow]> usage-rows;
    in property <[UsageRow]> subscription-limits;
    in property <[UsageDay]> usage-days;
    in property <SubscriptionView> subscription;
    in property <[UsageRow]> instance-quotas;
    in property <bool> dual-enabled;
    in property <bool> secondary-selected;
    callback select-instance(bool);
    callback expand();
    callback jump(string);
    callback select-page(bool);
    callback select-tasks(bool);
    callback refresh-usage();
    callback settings();
    property <bool> pulse;
    Timer { interval: 700ms; running: true; triggered => { root.pulse = !root.pulse; } }
    Rectangle {
        border-radius: 14px;
        background: Theme.card-bg;
        border-width: 1px;
        border-color: Theme.hairline;
        if root.compact: VerticalLayout {
            padding: 14px;
            spacing: 10px;
            alignment: start;
            Text { text: root.waiting-total + " waiting for you"; color: Theme.faint; font-size: 11px; height: 14px; }
            SessionList { sessions: root.sessions; pulse: root.pulse; jump(id) => { root.jump(id); } }
            Rectangle {
                height: 20px;
                Text { text: root.waiting-total > root.sessions.length ? "View all " + root.waiting-total + " waiting sessions →" : "View all sessions →"; color: Theme.dim; font-size: 11px; vertical-alignment: center; }
                TouchArea { mouse-cursor: pointer; clicked => { root.expand(); } }
            }
        }
        if !root.compact: VerticalLayout {
            padding: 14px;
            spacing: 12px;
            HorizontalLayout {
                height: 30px;
                spacing: 6px;
                PanelButton { label: "Tasks"; selected: !root.usage-page; clicked => { root.usage-page = false; root.select-page(false); } }
                PanelButton { label: "Usage"; selected: root.usage-page; clicked => { root.usage-page = true; root.select-page(true); } }
                Rectangle { horizontal-stretch: 1; }
                Text { text: "Agent Companion"; color: Theme.faint; font-size: 10px; vertical-alignment: center; }
            }
            Rectangle { height: 1px; background: Theme.hairline; }
            // Both pages stay mounted in a single fixed viewport. Switching
            // changes visibility, so each ScrollView keeps its own position.
            Rectangle {
                vertical-stretch: 1;
                VerticalLayout {
                    visible: !root.usage-page;
                    spacing: 10px;
                    HorizontalLayout {
                        height: 28px;
                        spacing: 6px;
                        PanelButton { label: "Active · " + root.active-count; selected: !root.finished; clicked => { root.finished = false; root.task-scroll-y = 0px; root.select-tasks(false); } }
                        PanelButton { label: "Finished · " + root.finished-count; selected: root.finished; clicked => { root.finished = true; root.task-scroll-y = 0px; root.select-tasks(true); } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    ScrollView {
                        viewport-width: self.visible-width;
                        viewport-y <=> root.task-scroll-y;
                        horizontal-scrollbar-policy: always-off;
                        VerticalLayout {
                            alignment: start;
                            spacing: 14px;
                            padding-right: 4px;
                            for quota in root.instance-quotas: Rectangle {
                                height: 58px;
                                border-radius: 8px;
                                background: quota-touch.has-hover ? Theme.soft-hot : Theme.soft;
                                HorizontalLayout {
                                    padding: 10px;
                                    VerticalLayout {
                                        Text { text: quota.label; color: Theme.text; font-size: 12px; font-weight: 600; }
                                        Text { text: quota.resets; color: Theme.faint; font-size: 10px; overflow: elide; }
                                    }
                                    Text { text: quota.value; color: quota.tier == "good" ? Theme.plenty : quota.tier == "warn" ? Theme.thin : quota.tier == "low" ? Theme.spent : Theme.dim; font-size: 20px; horizontal-alignment: right; vertical-alignment: center; }
                                }
                                quota-touch := TouchArea { mouse-cursor: pointer; clicked => { root.select-instance(quota.agent == "dodex"); } }
                            }
                            if root.sessions.length == 0: Text { text: root.finished ? "No finished tasks" : "No active tasks"; color: Theme.dim; font-size: 12px; }
                            SessionList { sessions: root.sessions; pulse: root.pulse; jump(id) => { root.jump(id); } }
                            if root.usage-rows.length > 0: Rectangle { height: 1px; background: Theme.hairline; }
                            QuotaRows { rows: root.usage-rows; }
                        }
                    }
                }
                VerticalLayout {
                    visible: root.usage-page;
                    spacing: 10px;
                    if root.dual-enabled: HorizontalLayout {
                        height: 28px;
                        PanelButton { label: "Codex"; selected: !root.secondary-selected; clicked => { root.select-instance(false); } }
                        PanelButton { label: "Dodex"; selected: root.secondary-selected; clicked => { root.select-instance(true); } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    HorizontalLayout {
                        height: 28px;
                        Text { text: root.subscription.loading ? "Refreshing…" : root.subscription.updated; color: Theme.dim; font-size: 10px; vertical-alignment: center; }
                        PanelButton { label: "Refresh"; available: !root.subscription.loading; horizontal-stretch: 0; clicked => { root.refresh-usage(); } }
                    }
                    ScrollView {
                        viewport-width: self.visible-width;
                        viewport-y <=> root.usage-scroll-y;
                        horizontal-scrollbar-policy: always-off;
                        VerticalLayout {
                            padding-right: 4px;
                            SubscriptionContent { data: root.subscription; limits: root.subscription-limits; days: root.usage-days; }
                        }
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.hairline; }
            HorizontalLayout {
                height: 28px;
                Text { text: root.usage-page ? (root.secondary-selected ? "Dodex subscription" : "Codex subscription") : "Click a task to return to it"; color: Theme.faint; font-size: 10px; vertical-alignment: center; }
                PanelButton { label: "Settings"; horizontal-stretch: 0; clicked => { root.settings(); } }
            }
        }
    }
}
