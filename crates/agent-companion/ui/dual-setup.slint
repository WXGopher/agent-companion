import { SettingsButton, SettingsCard, SettingsColors } from "settings-common.slint";

export component DualSetup inherits SettingsCard {
    in property <bool> tui-installed;
    in property <bool> tui-available;
    in property <bool> monitored;
    in property <bool> busy;
    in property <bool> blocked;
    in property <bool> error;
    in property <string> phase;
    in property <string> message;
    callback setup();
    callback open();
    vertical-stretch: 0;
    VerticalLayout {
        padding: 18px;
        spacing: 10px;
        Text { text: "TUI 双开"; font-size: 15px; font-weight: 600; color: SettingsColors.text; }
        Text { text: "Codex 和 Dodex 独立管理账号、配置、历史、程序包及后台服务，允许使用不同版本。首次使用 Dodex 请自行登录。"; font-size: 12px; color: SettingsColors.secondary; wrap: word-wrap; }
        HorizontalLayout {
            spacing: 22px;
            Text { text: root.tui-installed ? "Dodex TUI · 已安装" : "Dodex TUI · 未安装"; font-size: 12px; color: root.tui-installed ? SettingsColors.accent : SettingsColors.secondary; }
            Text { text: root.tui-available ? "终端入口 · 已就绪" : "终端入口 · 未就绪"; font-size: 12px; color: root.tui-available ? SettingsColors.accent : SettingsColors.secondary; }
            Rectangle { horizontal-stretch: 1; }
        }
        HorizontalLayout {
            spacing: 10px;
            SettingsButton {
                text: root.busy ? "正在配置…" : root.tui-installed ? "修复 TUI 安装" : "安装 Dodex TUI";
                enabled: !root.busy && !root.blocked;
                primary: true;
                accessible-label: root.tui-installed ? "修复独立 Dodex TUI 安装与终端入口" : "安装独立 Dodex TUI 与终端入口";
                clicked => { root.setup(); }
            }
            if root.tui-available: SettingsButton {
                text: "打开终端";
                accessible-label: "在终端中打开 Dodex TUI";
                enabled: !root.busy && !root.blocked;
                clicked => { root.open(); }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        if root.busy || root.message != "": Text { text: root.busy ? root.phase : root.message; font-size: 12px; color: !root.busy && root.error ? SettingsColors.error : SettingsColors.secondary; wrap: word-wrap; }
    }
}
